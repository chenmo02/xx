<Page x:Class="WpfApp1.Views.JsonDiffPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="clr-namespace:WpfApp1.Controls"
      Background="{DynamicResource PageBackgroundAltBrush}" Foreground="#17345F" FontFamily="Microsoft YaHei UI, Segoe UI"
      UseLayoutRounding="True" SizeChanged="Page_SizeChanged">
    <Page.Resources>
        <Style TargetType="controls:JsonDiffEditor">
            <Style.Resources>
                <SolidColorBrush x:Key="PageScrollThumbBrush" Color="#465A73"/>
                <SolidColorBrush x:Key="PageScrollThumbHoverBrush" Color="#6481A4"/>
                <SolidColorBrush x:Key="PageScrollThumbPressedBrush" Color="#80ABDE"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#1C293B"/>
            </Style.Resources>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#FEFFFFFF"/>
            <Setter Property="BorderBrush" Value="#DCE7F7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
        </Style>
        <Style x:Key="Action" TargetType="Button">
            <Setter Property="Foreground" Value="#214471"/>
            <Setter Property="Background" Value="#FAFCFF"/>
            <Setter Property="BorderBrush" Value="#D5E2F5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="13,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.78"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.6"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#1677FF"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryAction" TargetType="Button" BasedOn="{StaticResource Action}">
            <Setter Property="Background" Value="#1677FF"/><Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#1677FF"/>
        </Style>
        <Style x:Key="EditorAction" TargetType="Button" BasedOn="{StaticResource Action}">
            <Setter Property="Padding" Value="9,4"/><Setter Property="FontSize" Value="11"/>
        </Style>
        <Style x:Key="Stat" TargetType="CheckBox">
            <Setter Property="IsChecked" Value="True"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Tile" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="6" Padding="12,9">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="False"><Setter TargetName="Tile" Property="Opacity" Value="0.4"/></Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Tile" Property="BorderBrush" Value="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Tile" Property="BorderBrush" Value="#1677FF"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="NavItem" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="10,8"/><Setter Property="Margin" Value="0,1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Row" BorderBrush="#EAF0F9" BorderThickness="3,0,0,1" Padding="{TemplateBinding Padding}" Background="Transparent">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="#F1F6FF"/></Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="#EAF2FF"/>
                                <Setter TargetName="Row" Property="BorderBrush" Value="#1677FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ValueText" TargetType="TextBlock">
            <Setter Property="Margin" Value="12,9"/><Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/><Setter Property="FontSize" Value="12"/>
        </Style>
    </Page.Resources>
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid x:Name="ContentLayout" Margin="18,14,18,24" MinWidth="580" MinHeight="580">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="3*" MinHeight="260"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="2*" MinHeight="160"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                        <TextBlock Text="JSON内容比对" FontSize="22" FontWeight="Bold" Foreground="#0F172A"/>
                        <TextBlock Text="快速对比两个 JSON 数据的差异，支持新增、删除、修改、类型变化。" Foreground="#94A3B8" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="交换左右" Style="{DynamicResource ButtonGhost}" Padding="16,8" FontWeight="SemiBold" Click="BtnSwap_Click" Margin="0,0,8,0"/>
                        <Button Content="清空" Style="{DynamicResource ButtonGhost}" Padding="16,8" FontWeight="SemiBold" Click="BtnClearAll_Click" Margin="0,0,8,0"/>
                        <Button x:Name="BtnCompare" Content="开始对比" Style="{DynamicResource ButtonPrimary}" Padding="16,8" FontWeight="SemiBold" Click="BtnCompare_Click"/>
                    </StackPanel>
                </Grid>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="0.32*" MinWidth="150" MaxWidth="240"/></Grid.ColumnDefinitions>
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="195"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*" MinWidth="195"/></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource Card}">
                                <DockPanel>
                                    <Grid DockPanel.Dock="Top" Margin="10,7" SizeChanged="EditorHeader_SizeChanged">
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" Margin="0,4,10,4" VerticalAlignment="Center">
                                            <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" Foreground="#1677FF" FontSize="17" Margin="0,0,7,0"/>
                                            <TextBlock Text="JSON A（原始数据）" FontSize="12" FontWeight="SemiBold"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,2">
                                            <Border Background="#E5EFFF" CornerRadius="9" Padding="7,1" Margin="0,0,8,0" VerticalAlignment="Center"><TextBlock Text="原始" FontSize="10" Foreground="#4486EB" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"/></Border>
                                            <Button Content="导入" Style="{StaticResource EditorAction}" Click="BtnImportA_Click" Margin="0,0,6,0"/>
                                            <Button Content="{}{ }  格式化" Style="{StaticResource EditorAction}" Click="BtnBeautifyA_Click"/>
                                        </StackPanel>
                                    </Grid>
                                    <controls:JsonDiffEditor x:Name="EditorA"/>
                                </DockPanel>
                            </Border>
                            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Center" Background="Transparent"/>
                            <Border Grid.Column="2" Style="{StaticResource Card}">
                                <DockPanel>
                                    <Grid DockPanel.Dock="Top" Margin="10,7" SizeChanged="EditorHeader_SizeChanged">
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" Margin="0,4,10,4" VerticalAlignment="Center">
                                            <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" Foreground="#1677FF" FontSize="17" Margin="0,0,7,0"/>
                                            <TextBlock Text="JSON B（修改后）" FontSize="12" FontWeight="SemiBold"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,2">
                                            <Border Background="#DFF7EE" CornerRadius="9" Padding="7,1" Margin="0,0,8,0" VerticalAlignment="Center"><TextBlock Text="已修改" FontSize="10" Foreground="#16A578" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"/></Border>
                                            <Button Content="导入" Style="{StaticResource EditorAction}" Click="BtnImportB_Click" Margin="0,0,6,0"/>
                                            <Button Content="{}{ }  格式化" Style="{StaticResource EditorAction}" Click="BtnBeautifyB_Click"/>
                                        </StackPanel>
                                    </Grid>
                                    <controls:JsonDiffEditor x:Name="EditorB"/>
                                </DockPanel>
                            </Border>
                        </Grid>
                        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="6,9" Margin="0,12,0,0">
                            <UniformGrid Columns="4">
                                <CheckBox x:Name="ChkShowAdded" Style="{StaticResource Stat}" Background="#F0FCF8" BorderBrush="#DDF5EC" Foreground="#14AD7C" Checked="Filter_Changed" Unchecked="Filter_Changed" ToolTip="显示或隐藏新增项">
                                    <StackPanel><TextBlock Text="⊕  新增" FontSize="12"/><TextBlock x:Name="CountAdded" Text="0" FontSize="23" FontWeight="SemiBold" Margin="0,2,0,0"/></StackPanel>
                                </CheckBox>
                                <CheckBox x:Name="ChkShowRemoved" Style="{StaticResource Stat}" Background="#FFF3F6" BorderBrush="#FBE4EB" Foreground="#F25C73" Checked="Filter_Changed" Unchecked="Filter_Changed" ToolTip="显示或隐藏删除项">
                                    <StackPanel><TextBlock Text="⊖  删除" FontSize="12"/><TextBlock x:Name="CountRemoved" Text="0" FontSize="23" FontWeight="SemiBold" Margin="0,2,0,0"/></StackPanel>
                                </CheckBox>
                                <CheckBox x:Name="ChkShowModified" Style="{StaticResource Stat}" Background="#FFFAF1" BorderBrush="#FAEDD9" Foreground="#ED9223" Checked="Filter_Changed" Unchecked="Filter_Changed" ToolTip="显示或隐藏修改项">
                                    <StackPanel><TextBlock Text="✎  修改" FontSize="12"/><TextBlock x:Name="CountModified" Text="0" FontSize="23" FontWeight="SemiBold" Margin="0,2,0,0"/></StackPanel>
                                </CheckBox>
                                <CheckBox x:Name="ChkShowTypeChanged" Style="{StaticResource Stat}" Background="#F8F3FF" BorderBrush="#EEE4FC" Foreground="#9956EF" Checked="Filter_Changed" Unchecked="Filter_Changed" ToolTip="显示或隐藏类型变化项">
                                    <StackPanel><TextBlock Text="⇄  类型变化" FontSize="12"/><TextBlock x:Name="CountTypeChanged" Text="0" FontSize="23" FontWeight="SemiBold" Margin="0,2,0,0"/></StackPanel>
                                </CheckBox>
                            </UniformGrid>
                        </Border>
                    </Grid>
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Border Style="{StaticResource Card}" Padding="5,10">
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Top" Margin="9,3,8,12">
                                    <TextBlock Text="差异导航" FontSize="14" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="NavCount" Text="0 处差异" FontSize="11" Foreground="#4D88E8" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </DockPanel>
                                <Grid>
                                    <ListBox x:Name="DiffNavigation" Style="{x:Null}" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource NavItem}"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="DiffNavigation_SelectionChanged">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="25"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                    <Border Background="{Binding Accent}" CornerRadius="5" Width="19" Height="19" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Symbol}" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14"/>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                                        <TextBlock Text="{Binding Path}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" Foreground="#17345F" FontSize="12"/>
                                                        <DockPanel Margin="0,5,0,0">
                                                            <TextBlock Text="{Binding TypeLabel}" Foreground="{Binding Accent}" FontSize="11"/>
                                                            <TextBlock Text="{Binding LineLabel}" Foreground="#8599B7" FontSize="10" HorizontalAlignment="Right"/>
                                                        </DockPanel>
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <TextBlock x:Name="NavEmpty" Text="对比后可点击差异定位" Foreground="#8B9DB5" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </DockPanel>
                        </Border>
                        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="13,20" Margin="0,8,0,0">
                            <CheckBox x:Name="ChkOnlyDiff" IsChecked="True" Checked="Filter_Changed" Unchecked="Filter_Changed" ToolTip="关闭后，详情表格同时显示未变化的字段" Cursor="Hand">
                                <CheckBox.Template>
                                    <ControlTemplate TargetType="CheckBox">
                                        <DockPanel>
                                            <Border DockPanel.Dock="Right" x:Name="Track" Width="32" Height="18" CornerRadius="9" Background="#C6D2E3">
                                                <Ellipse x:Name="Thumb" Width="14" Height="14" Fill="White" HorizontalAlignment="Left" Margin="2"/>
                                            </Border>
                                            <TextBlock Text="仅显示差异" FontSize="12" Foreground="#214471" VerticalAlignment="Center"/>
                                        </DockPanel>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="#1677FF"/><Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/></Trigger>
                                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Track" Property="BorderBrush" Value="#17345F"/><Setter TargetName="Track" Property="BorderThickness" Value="1"/></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </CheckBox.Template>
                            </CheckBox>
                        </Border>
                    </Grid>
                </Grid>
                <GridSplitter Grid.Row="2" Height="8" HorizontalAlignment="Stretch" Background="Transparent" ResizeBehavior="PreviousAndNext"/>
                <Border Grid.Row="3" Style="{StaticResource Card}" Padding="14,10">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                            <TextBlock Text="差异详情" FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock x:Name="DetailHint" Text="点击记录可定位到源 JSON" FontSize="11" Foreground="#8B9DB5" HorizontalAlignment="Right"/>
                        </DockPanel>
                        <Grid>
                            <DataGrid x:Name="DiffDetails" Style="{x:Null}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                                      CanUserReorderColumns="False" CanUserSortColumns="False" HeadersVisibility="Column" RowHeaderWidth="0" GridLinesVisibility="All"
                                      HorizontalGridLinesBrush="#E7EDF6" VerticalGridLinesBrush="#E7EDF6" BorderBrush="#E0E9F7" BorderThickness="1"
                                      Background="White" Foreground="#264166" SelectionMode="Single" SelectionUnit="FullRow" SelectionChanged="DiffDetails_SelectionChanged"
                                      EnableRowVirtualization="True" EnableColumnVirtualization="True" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                                <DataGrid.ColumnHeaderStyle>
                                    <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#F4F8FE"/><Setter Property="Foreground" Value="#43618C"/><Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Padding" Value="12,8"/><Setter Property="BorderBrush" Value="#E7EDF6"/><Setter Property="BorderThickness" Value="0,0,1,1"/></Style>
                                </DataGrid.ColumnHeaderStyle>
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow"><Setter Property="Background" Value="{Binding RowBackground}"/><Setter Property="MinHeight" Value="37"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#E4EFFF"/></Trigger></Style.Triggers></Style>
                                </DataGrid.RowStyle>
                                <DataGrid.CellStyle>
                                    <Style TargetType="DataGridCell"><Setter Property="BorderThickness" Value="0"/><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#264166"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell"><ContentPresenter/></ControlTemplate></Setter.Value></Setter></Style>
                                </DataGrid.CellStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="40" ElementStyle="{StaticResource ValueText}"/>
                                    <DataGridTextColumn Header="字段路径" Binding="{Binding Path}" Width="2*" MinWidth="130" ElementStyle="{StaticResource ValueText}"/>
                                    <DataGridTemplateColumn Header="变化类型" Width="1.2*" MinWidth="100"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding TypeDisplay}" Foreground="{Binding Accent}" Style="{StaticResource ValueText}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="原始值" Width="2*"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding OldDisplay}" Foreground="#B84F5C" Style="{StaticResource ValueText}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="修改后值" Width="2*"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding NewDisplay}" Foreground="#15A777" Style="{StaticResource ValueText}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock x:Name="EmptyMessage" Text="在两侧粘贴或导入 JSON，点击「开始对比」查看差异" Foreground="#8B9DB5" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,30,0,0"/>
                        </Grid>
                    </DockPanel>
                </Border>
                <Border Grid.Row="4" Style="{StaticResource Card}" Padding="12,8" Margin="0,10,0,0">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button x:Name="BtnCopyReport" Content="复制报告" Style="{StaticResource Action}" Click="BtnCopyReport_Click" Margin="0,0,8,0" IsEnabled="False"/>
                            <Button x:Name="BtnExportReport" Content="导出报告" Style="{StaticResource PrimaryAction}" Click="BtnExportReport_Click" IsEnabled="False"/>
                        </StackPanel>
                        <TextBlock x:Name="TxtDiffSummary" Text="等待对比" FontSize="11" Foreground="#8094B1" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,10,0"/>
                    </DockPanel>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
