<Page x:Class="WpfApp1.Views.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{DynamicResource PageBackgroundBrush}"
      FontFamily="Microsoft YaHei UI"
      TextOptions.TextFormattingMode="Display"
      UseLayoutRounding="True">

    <Page.Resources>
        <Style x:Key="QuickCardIconStyle" TargetType="Border">
            <Setter Property="Width" Value="56"/>
            <Setter Property="Height" Value="56"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Background" Value="#EEF2FF"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
        <Style x:Key="HomeCardStyle" TargetType="Border">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="White" Offset="0"/>
                        <GradientStop Color="White" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush" Value="#E6EDFA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20,24"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="MinHeight" Value="260"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#C9D7EE" BlurRadius="12" ShadowDepth="3" Opacity="0.16"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <ColorAnimation Storyboard.TargetProperty="(Border.Background).(GradientBrush.GradientStops)[0].(GradientStop.Color)"
                                                To="#FAFBFF" Duration="0:0:0.25"/>
                                <ColorAnimation Storyboard.TargetProperty="(Border.Background).(GradientBrush.GradientStops)[1].(GradientStop.Color)"
                                                To="#E5ECFF" Duration="0:0:0.25"/>
                                <ColorAnimation Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                To="#B8C8FF" Duration="0:0:0.25"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <ColorAnimation Storyboard.TargetProperty="(Border.Background).(GradientBrush.GradientStops)[0].(GradientStop.Color)"
                                                To="White" Duration="0:0:0.2"/>
                                <ColorAnimation Storyboard.TargetProperty="(Border.Background).(GradientBrush.GradientStops)[1].(GradientStop.Color)"
                                                To="White" Duration="0:0:0.2"/>
                                <ColorAnimation Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                To="#E6EDFA" Duration="0:0:0.2"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <ScrollViewer Style="{DynamicResource PageScrollViewerStyle}" Padding="32,28"
                  SizeChanged="HomeScrollViewer_SizeChanged">
        <Grid MaxWidth="1280"
              MinHeight="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border
                    CornerRadius="12"
                    Padding="24,20"
                    MinHeight="120"
                    Margin="0,0,0,24"
                    BorderBrush="#E3EBFA"
                    BorderThickness="1">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#FFFFFF" Offset="0"/>
                        <GradientStop Color="#F0F3FF" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="欢迎使用 CC 实施工具箱"
                                   FontSize="26"
                                   FontWeight="Bold"
                                   Foreground="#101A42"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="高效、安全的数据实施与办公辅助工具"
                                   FontSize="14"
                                   Foreground="#7B8BB0"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0"/>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock Text="by"
                                       FontSize="12"
                                       Foreground="#9CA3AF"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="悲伤番茄"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="#fe491a"
                                       Margin="6,0,0,0"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>

                    <Border Grid.Column="1"
                            Padding="24,14"
                            Background="#EEF2FF"
                            CornerRadius="10"
                            VerticalAlignment="Center">
                        <StackPanel>
                            <!-- 发布前改版本号 -->
                            <TextBlock Text="当前版本"
                                       FontSize="12"
                                       HorizontalAlignment="Center"
                                       Foreground="#7B8BB0"/>
                            <TextBlock x:Name="TxtVersionBadge"
                                       FontSize="24"
                                       FontWeight="Bold"
                                       Foreground="#4E6EF2"
                                       Margin="0,2,0,0"><Run Text="v2.3."/><Run Language="zh-cn" Text="4"/></TextBlock>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                <Path Data="M 7,0 L 17,0 L 12,8 L 18,8 L 4,24 L 8,13 L 2,13 Z"
                      Fill="#4E6EF2" Width="18" Height="24" Stretch="Uniform"
                      VerticalAlignment="Center" Margin="0,0,12,0"/>
                <TextBlock Text="快捷功能" FontSize="20" FontWeight="SemiBold"
                           Foreground="#101A42" VerticalAlignment="Center"/>
            </StackPanel>

            <UniformGrid x:Name="QuickCards" Grid.Row="2" Columns="4" Margin="-8,0,-8,16">
                <Border Style="{StaticResource HomeCardStyle}" MouseLeftButtonUp="GoToImport_Click">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border Style="{StaticResource QuickCardIconStyle}" Background="#FF88A4FF">
                            <Image Source="/img/数据集投影转换.png" 
                                   Stretch="Uniform"
                                   Width="38" Height="38"
                                   HorizontalAlignment="Center" 
                                   VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Row="1" Margin="0,14,0,0">
                            <TextBlock Text="临时数据建表" FontSize="18" FontWeight="SemiBold" Foreground="#101A42" TextWrapping="Wrap"/>
                            <TextBlock Text="Excel、CSV、DBF 一键转换为 SQL 临时表脚本"
                                       FontSize="13"
                                       Foreground="#7B8BB0"
                                       Margin="0,8,0,0"
                                       TextWrapping="Wrap"
                                       LineHeight="24"/>
                        </StackPanel>
                        <TextBlock Grid.Row="2" Text="点击进入" FontSize="14" FontWeight="SemiBold" Foreground="#4F46E5" Margin="0,14,0,0"/>
                    </Grid>
                </Border>

                <Border Style="{StaticResource HomeCardStyle}" MouseLeftButtonUp="GoToCsvViewer_Click">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border Style="{StaticResource QuickCardIconStyle}" Background="#FF6AE7C0">
                            <Image Source="/img/筛选.png" 
                                   Stretch="Uniform"
                                   Width="38" Height="38"
                                   HorizontalAlignment="Center" 
                                   VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Row="1" Margin="0,14,0,0">
                            <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="#101A42" TextWrapping="Wrap"><Run Text="CSV"/><Run Language="zh-cn" Text=" "/><Run Text="文件预览"/></TextBlock>
                            <TextBlock Text="稳定打开分隔文本，支持搜索、定位与编码识别"
                                       FontSize="13"
                                       Foreground="#7B8BB0"
                                       Margin="0,8,0,0"
                                       TextWrapping="Wrap"
                                       LineHeight="24"/>
                        </StackPanel>
                        <TextBlock Grid.Row="2" Text="点击进入" FontSize="14" FontWeight="SemiBold" Foreground="#059669" Margin="0,14,0,0"/>
                    </Grid>
                </Border>

                <Border Style="{StaticResource HomeCardStyle}" MouseLeftButtonUp="GoToQuickTable_Click">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border Style="{StaticResource QuickCardIconStyle}" Background="#DBEAFE">
                            <Image Source="/img/快速建表.png"
                                   Stretch="Uniform"
                                   Width="38" Height="38"
                                   HorizontalAlignment="Center" 
                                   VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Row="1" Margin="0,14,0,0">
                            <TextBlock Text="快速建数据表" FontSize="18" FontWeight="SemiBold" Foreground="#101A42" TextWrapping="Wrap"/>
                            <TextBlock Text="粘贴 INSERT INTO，自动提取字段、推断类型并生成建表 SQL"
                                       FontSize="13"
                                       Foreground="#7B8BB0"
                                       Margin="0,8,0,0"
                                       TextWrapping="Wrap"
                                       LineHeight="24"/>
                        </StackPanel>
                        <TextBlock Grid.Row="2" Text="点击进入" FontSize="14" FontWeight="SemiBold" Foreground="#2563EB" Margin="0,14,0,0"/>
                    </Grid>
                </Border>

                <Border Style="{StaticResource HomeCardStyle}" MouseLeftButtonUp="GoToJsonTool_Click">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border Style="{StaticResource QuickCardIconStyle}" Background="#CEE8FF">
                            <Image Source="/img/数据处理.png" 
                                   Stretch="Uniform"
                                   Width="38" Height="38"
                                   HorizontalAlignment="Center" 
                                   VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Row="1" Margin="0,14,0,0">
                            <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="#101A42" TextWrapping="Wrap"><Run Text="JSON"/><Run Language="zh-cn" Text=" "/><Run Text="数据解析"/></TextBlock>
                            <TextBlock Text="格式化、校验、搜索与嵌套 GRID 浏览一体完成"
                                       FontSize="13"
                                       Foreground="#7B8BB0"
                                       Margin="0,8,0,0"
                                       TextWrapping="Wrap"
                                       LineHeight="24"/>
                        </StackPanel>
                        <TextBlock Grid.Row="2" Text="点击进入" FontSize="14" FontWeight="SemiBold" Foreground="#0284C7" Margin="0,14,0,0"/>
                    </Grid>
                </Border>

                <Border Style="{StaticResource HomeCardStyle}" MouseLeftButtonUp="GoToJsonDiff_Click">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border Style="{StaticResource QuickCardIconStyle}" Background="#FCD7EF">
                            <Image Source="/img/sql语句查询.png" 
                                   Stretch="Uniform"
                                   Width="38" Height="38"
                                   HorizontalAlignment="Center" 
                                   VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Row="1" Margin="0,14,0,0">
                            <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="#101A42" TextWrapping="Wrap"><Run Text="JSON"/><Run Language="zh-cn" Text=" "/><Run Text="内容比对"/></TextBlock>
                            <TextBlock Text="深度比较结构和值差异，快速定位新增、删除和变更"
                                       FontSize="13"
                                       Foreground="#7B8BB0"
                                       Margin="0,8,0,0"
                                       TextWrapping="Wrap"
                                       LineHeight="24"/>
                        </StackPanel>
                        <TextBlock Grid.Row="2" Text="点击进入" FontSize="14" FontWeight="SemiBold" Foreground="#7C3AED" Margin="0,14,0,0"/>
                    </Grid>
                </Border>

                <Border Style="{StaticResource HomeCardStyle}" MouseLeftButtonUp="GoToDrawBoard_Click">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border Style="{StaticResource QuickCardIconStyle}" Background="#E9DCFF">
                            <Image Source="/img/excalidraw.png" 
                                   Stretch="Uniform"
                                   Width="35" Height="35"
                                   HorizontalAlignment="Center" 
                                   VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Row="1" Margin="0,14,0,0">
                            <TextBlock Text="在线绘图工具" FontSize="18" FontWeight="SemiBold" Foreground="#101A42" TextWrapping="Wrap"/>
                            <TextBlock Text="流程图、草图和示意图快速绘制，适合沟通方案"
                                       FontSize="13"
                                       Foreground="#7B8BB0"
                                       Margin="0,8,0,0"
                                       TextWrapping="Wrap"
                                       LineHeight="24"/>
                        </StackPanel>
                        <TextBlock Grid.Row="2" Text="点击进入" FontSize="14" FontWeight="SemiBold" Foreground="#DB2777" Margin="0,14,0,0"/>
                    </Grid>
                </Border>

                <Border Style="{StaticResource HomeCardStyle}" MouseLeftButtonUp="GoToInvoice_Click">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border Style="{StaticResource QuickCardIconStyle}" Background="#DDF7B7">
                            <Image Source="/img/输出图片.png" 
                                   Stretch="Uniform"
                                   Width="38" Height="38"
                                   HorizontalAlignment="Center" 
                                   VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Row="1" Margin="0,14,0,0">
                            <TextBlock Text="发票打印操作" FontSize="18" FontWeight="SemiBold" Foreground="#101A42" TextWrapping="Wrap"/>
                            <TextBlock Text="PDF、OFD 排版打印与模板管理，适合办公场景"
                                       FontSize="13"
                                       Foreground="#7B8BB0"
                                       Margin="0,8,0,0"
                                       TextWrapping="Wrap"
                                       LineHeight="24"/>
                        </StackPanel>
                        <TextBlock Grid.Row="2" Text="点击进入" FontSize="14" FontWeight="SemiBold" Foreground="#65A30D" Margin="0,14,0,0"/>
                    </Grid>
                </Border>

                <Border Style="{StaticResource HomeCardStyle}" MouseLeftButtonUp="GoToDataValidation_Click">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border Style="{StaticResource QuickCardIconStyle}" Background="#EEF2FF">
                            <Image Source="/img/检查.png" 
                                   Stretch="Uniform"
                                   Width="38" Height="38"
                                   HorizontalAlignment="Center" 
                                   VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Row="1" Margin="0,14,0,0">
                            <TextBlock Text="数据验证排查" FontSize="18" FontWeight="SemiBold" Foreground="#101A42" TextWrapping="Wrap"/>
                            <TextBlock Text="导入 DDL 与 INSERT 数据，自动映射字段并逐行校验类型约束"
                                       FontSize="13"
                                       Foreground="#7B8BB0"
                                       Margin="0,8,0,0"
                                       TextWrapping="Wrap"
                                       LineHeight="24"/>
                        </StackPanel>
                        <TextBlock Grid.Row="2" Text="点击进入" FontSize="14" FontWeight="SemiBold" Foreground="#4E6EF2" Margin="0,14,0,0"/>
                    </Grid>
                </Border>
            </UniformGrid>

            <Border Grid.Row="3" Background="#F8FAFF"
                    CornerRadius="12"
                    Padding="16"
                    BorderBrush="#E3EBFA"
                    BorderThickness="1">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="4,0,0,14">
                        <Path Data="M 0,6 L 10,0 L 20,6 L 10,12 Z M 0,10 L 10,16 L 20,10 M 0,14 L 10,20 L 20,14"
                              Stroke="#4E6EF2" StrokeThickness="2" StrokeLineJoin="Round"
                              Width="20" Height="20" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <TextBlock Text="系统信息" FontSize="17" FontWeight="SemiBold" Foreground="#101A42"/>
                    </StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="White" BorderBrush="#E6EDFA" BorderThickness="1"
                                CornerRadius="10" Padding="18,16">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border Width="38" Height="38" CornerRadius="19" Background="#F0F3FF" Margin="0,0,12,0">
                                    <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                                               Foreground="#4E6EF2" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel>
                                    <TextBlock Text="创世主" FontSize="12" Foreground="#7B8BB0"/>
                                    <TextBlock x:Name="TxtRuntime" Text="悲伤番茄" FontSize="18" FontWeight="Bold"
                                               Foreground="#fe491a" Margin="0,4,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Background="White" BorderBrush="#E6EDFA" BorderThickness="1"
                                CornerRadius="10" Padding="18,16">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border Width="38" Height="38" CornerRadius="19" Background="#F0F3FF" Margin="0,0,12,0">
                                    <TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                                               Foreground="#4E6EF2" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel>
                                    <TextBlock Text="最新发布日期" FontSize="12" Foreground="#7B8BB0"/>
                                    <TextBlock x:Name="TxtReleaseDate" FontSize="18" FontWeight="Bold"
                                               Foreground="#101A42" Margin="0,4,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
