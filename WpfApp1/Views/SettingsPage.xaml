<Page x:Class="WpfApp1.Views.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{DynamicResource PageBackgroundBrush}">

    <Page.Resources>
        <!-- 卡片标题 -->
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#222"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <!-- 卡片描述 -->
        <Style x:Key="CardDesc" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Foreground" Value="#999"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <!-- 标签文字 -->
        <Style x:Key="LabelText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#555"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="SqlPreferenceComboBox" TargetType="ComboBox" BasedOn="{StaticResource ComboBoxStandard}">
            <Setter Property="Height" Value="40"/>
        </Style>

        <Style x:Key="SqlPreferenceTextBox" TargetType="TextBox" BasedOn="{StaticResource TextBoxStandard}">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="10,5"/>
        </Style>

        <Style x:Key="SqlPreferenceButton" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="MinHeight" Value="42"/>
            <Setter Property="Foreground" Value="{DynamicResource ButtonGhostForegroundBrush}"/>
            <Setter Property="Background" Value="{DynamicResource ButtonGhostBackgroundBrush}"/>
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <DockPanel>
                                <TextBlock x:Name="StateIcon" Text="○" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True"/>
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter TargetName="StateIcon" Property="Text" Value="✓"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.78"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Page.Resources>

    <ScrollViewer Style="{DynamicResource PageScrollViewerStyle}" Padding="18,14,18,24">
        <StackPanel>

            <!-- 页面标题 -->
            <TextBlock Text="⚙️ 系统设置" FontSize="22" FontWeight="Bold" Foreground="#222" Margin="0,0,0,4"/>
            <TextBlock Text="全局配置与工具位预留" FontSize="13" Foreground="#999" Margin="0,0,0,14"/>

            <!-- ═══════════════════════════════════════ -->
            <!-- 1. SQL 生成偏好 -->
            <!-- ═══════════════════════════════════════ -->
            <Border Style="{DynamicResource CardBorder}" Padding="18" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="🗄️ SQL 生成偏好" Style="{StaticResource CardTitle}"/>
                    <TextBlock Text="保存后会自动应用到数据导入页和导出对话框" Style="{StaticResource CardDesc}"/>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="默认数据库类型" Style="{StaticResource LabelText}"/>
                            <ComboBox x:Name="CmbDefaultDbType" SelectedIndex="0"
                                         Style="{StaticResource SqlPreferenceComboBox}"
                                         ItemContainerStyle="{DynamicResource ComboBoxItemStandard}">
                                <ComboBoxItem Content="PostgreSQL"/>
                                <ComboBoxItem Content="SQL Server"/>
                                <ComboBoxItem Content="MySQL"/>
                                <ComboBoxItem Content="Oracle"/>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="默认表名" Style="{StaticResource LabelText}"/>
                            <TextBox x:Name="TxtDefaultTableName" Style="{StaticResource SqlPreferenceTextBox}" Text="temp_table"/>
                        </StackPanel>

                        <StackPanel Grid.Column="4">
                            <TextBlock Text="每批 INSERT 行数" Style="{StaticResource LabelText}"/>
                            <TextBox x:Name="TxtDefaultBatchSize" Style="{StaticResource SqlPreferenceTextBox}" Text="1000"/>
                        </StackPanel>
                    </Grid>

                    <Grid Width="470" HorizontalAlignment="Left" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ToggleButton x:Name="ChkDefaultDropIfExists"
                                      Content="默认生成 DROP TABLE"
                                      Style="{StaticResource SqlPreferenceButton}"
                                      IsChecked="True"/>
                        <ToggleButton x:Name="ChkDefaultBatchInsert" Grid.Column="2"
                                      Content="默认启用批量 INSERT"
                                      Style="{StaticResource SqlPreferenceButton}"
                                      IsChecked="True"/>
                        <ToggleButton x:Name="ChkDefaultLimitFieldLength" Grid.Column="4"
                                      Content="默认限制文本长度为 1000"
                                      Style="{StaticResource SqlPreferenceButton}"
                                      IsChecked="True"/>
                    </Grid>

                    <Border Background="#F8FAFC"
                            BorderBrush="#E5E7EB"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12,10">
                        <TextBlock Text="说明：这里填写的是默认表名本身。若你在数据导入页手动改过表名，系统不会强行覆盖。"
                                   FontSize="12"
                                   Foreground="#64748B"
                                   TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ═══════════════════════════════════════ -->
            <!-- 2. 默认路径 -->
            <!-- ═══════════════════════════════════════ -->
            <Border Style="{DynamicResource CardBorder}" Padding="18" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="📁 默认导出路径" Style="{StaticResource CardTitle}"/>
                    <TextBlock Text="SQL 文件、CSV 导出的默认保存位置" Style="{StaticResource CardDesc}"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtDefaultExportPath" Grid.Column="0" Style="{DynamicResource TextBoxStandard}"/>
                        <Button Grid.Column="1" Content="📁 浏览" Style="{DynamicResource ButtonSecondary}"
                                Margin="10,0,0,0" Click="BtnSelectExportPath_Click"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 保存设置按钮 -->
            <Button Content="💾 保存设置" Style="{DynamicResource ButtonPrimary}"
                    Padding="28,10" FontSize="14" FontWeight="SemiBold"
                    HorizontalAlignment="Left" Margin="0,0,0,28"
                    Click="BtnSaveSettings_Click"/>

            <!-- ═══════════════════════════════════════ -->
            <!-- 分隔线 — 实用小工具区域 -->
            <!-- ═══════════════════════════════════════ -->
            <Border Height="1" Background="#E5E5E5" Margin="0,0,0,20"/>
            <TextBlock Text="🔧 实用小工具" FontSize="18" FontWeight="Bold" Foreground="#222" Margin="0,0,0,4"/>
            <TextBlock Text="用于比较 CSV 文件并查看数据差异。" FontSize="13" Foreground="#999" Margin="0,0,0,18"/>

            <Border Style="{DynamicResource CardBorder}" Width="240" MinHeight="170"
                    HorizontalAlignment="Left" Padding="18" Margin="0,0,0,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="CSV 对比工具" FontSize="16" FontWeight="SemiBold" Foreground="#1F2937"/>
                    <TextBlock Grid.Row="1" Text="支持按行号或复合主键比较差异，结果可筛选导出。" FontSize="13" Foreground="#64748B" Margin="0,8,0,18" TextWrapping="Wrap"/>
                    <Button Grid.Row="2" Content="打开 CSV 对比工具" Style="{DynamicResource ButtonPrimary}" Padding="18,9" Click="BtnOpenCsvCompare_Click"/>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
