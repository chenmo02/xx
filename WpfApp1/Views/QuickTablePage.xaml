<Page x:Class="WpfApp1.Views.QuickTablePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:svc="clr-namespace:WpfApp1.Services"
      xmlns:controls="clr-namespace:WpfApp1.Controls"
      xmlns:behaviors="clr-namespace:WpfApp1.Behaviors"
      Background="{DynamicResource PageBackgroundAltBrush}">
    <Page.Resources>
        <Style x:Key="SettingButton" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Foreground" Value="{DynamicResource ButtonGhostForegroundBrush}"/>
            <Setter Property="Background" Value="{DynamicResource ButtonGhostBackgroundBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="StateIcon" Text="○" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter TargetName="StateIcon" Property="Text" Value="✓"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.78"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SqlOutputBox" TargetType="TextBox">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="Foreground" Value="Transparent"/>
            <Setter Property="SelectionBrush" Value="#426A9D"/>
            <Setter Property="SelectionOpacity" Value="0.6"/>
            <Setter Property="IsInactiveSelectionHighlightEnabled" Value="True"/>
            <Setter Property="Background" Value="#1F2B3D"/>
            <Setter Property="BorderBrush" Value="#33465D"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="#1F2B3D"
                                BorderBrush="#33465D"
                                BorderThickness="0"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Background="#1F2B3D"
                                          VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}"
                                          HorizontalScrollBarVisibility="{TemplateBinding HorizontalScrollBarVisibility}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>
    <ScrollViewer x:Name="PageScroller" Style="{DynamicResource PageScrollViewerStyle}"
                  behaviors:ScrollViewerAssist.EnableHiddenWheelScroll="False"
                  Padding="18,14,18,24" VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
        <StackPanel>
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,20,0">
                    <TextBlock Text="快速建数据表" FontSize="22" FontWeight="Bold" Foreground="#1A2332" Margin="0,0,0,4"/>
                    <TextBlock Text="粘贴 INSERT INTO，自动提取字段、推断类型并生成 CREATE TABLE。" FontSize="14" Foreground="#6B7A90" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                    <CheckBox x:Name="ChkQuote" Content="自动引用标识符" IsChecked="True"
                              Style="{StaticResource SettingButton}" Margin="0,0,8,0"
                              ToolTip="开启后引用表名和字段名，避免与数据库关键字冲突；点击切换。"/>
                    <CheckBox x:Name="ChkDrop" Content="生成前删除同名表" IsChecked="True"
                              Style="{StaticResource SettingButton}"
                              ToolTip="开启后在生成的 SQL 中加入删除同名表语句；执行该 SQL 会删除原表及其数据。点击切换。"/>
                </StackPanel>
            </Grid>

            <Border Style="{DynamicResource CardBorder}" Padding="18" Margin="0,0,0,14">
                <StackPanel>
                    <DockPanel Margin="0,0,0,14">
                        <TextBlock Text="1. 输入 INSERT SQL" FontSize="16" FontWeight="SemiBold" Foreground="#2D3748" DockPanel.Dock="Left"/>
                        <TextBlock Text="支持单表、多条 INSERT 和批量 VALUES" FontSize="12" Foreground="#9CA3AF" HorizontalAlignment="Right"/>
                    </DockPanel>
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0"><TextBlock Text="目标数据库" FontSize="13" Foreground="#4A5568" Margin="0,0,0,6"/><ComboBox x:Name="CmbDbType" SelectedIndex="0" Height="40" Style="{DynamicResource ComboBoxStandard}" ItemContainerStyle="{DynamicResource ComboBoxItemStandard}"><ComboBoxItem Content="PostgreSQL"/><ComboBoxItem Content="SQL Server"/><ComboBoxItem Content="MySQL"/><ComboBoxItem Content="Oracle"/></ComboBox></StackPanel>
                        <StackPanel Grid.Column="2"><TextBlock Text="表名" FontSize="13" Foreground="#4A5568" Margin="0,0,0,6"/><TextBox x:Name="TxtTableName" Height="40" Padding="10,4,10,4" VerticalContentAlignment="Center" Style="{DynamicResource TextBoxStandard}" TextChanged="TxtTableName_TextChanged" SelectionOpacity="0.4"/></StackPanel>
                        <StackPanel Grid.Column="4"><TextBlock Text="字段大小写" FontSize="13" Foreground="#4A5568" Margin="0,0,0,6"/><ComboBox x:Name="CmbCase" SelectedIndex="0" Height="40" Style="{DynamicResource ComboBoxStandard}" ItemContainerStyle="{DynamicResource ComboBoxItemStandard}"><ComboBoxItem Content="保持原样"/><ComboBoxItem Content="全部大写"/><ComboBoxItem Content="全部小写"/></ComboBox></StackPanel>
                    </Grid>
                    <TextBlock Text="INSERT INTO SQL" FontSize="13" FontWeight="SemiBold" Foreground="#4A5568" Margin="0,0,0,6"/>
                    <TextBox x:Name="TxtInsert" Height="122" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap" Style="{DynamicResource TextBoxStandard}" ToolTip="例如：INSERT INTO user_info (id, name) VALUES (1, '张三');"/>
                </StackPanel>
            </Border>

            <Border Style="{DynamicResource CardBorder}" Padding="18" Margin="0,0,0,14">
                <StackPanel>
                    <DockPanel Margin="0,0,0,12"><TextBlock Text="2. 字段预览与类型调整" FontSize="16" FontWeight="SemiBold" Foreground="#2D3748" DockPanel.Dock="Left"/><TextBlock x:Name="TxtStatus" Text="请先解析 INSERT SQL" FontSize="12" Foreground="#6B7A90" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis"/></DockPanel>
<WrapPanel Margin="0,0,0,12"><Button Content="解析并推断" Style="{DynamicResource ButtonPrimary}" Padding="20,9" Click="BtnParse_Click"/><TextBlock Text="全部字段类型" FontSize="13" Foreground="#4A5568" VerticalAlignment="Center" Margin="24,0,8,0"/><ComboBox x:Name="CmbAllType" Width="130" Height="40" ItemsSource="{x:Static svc:QuickTableService.TypeChoices}" Style="{DynamicResource ComboBoxStandard}" ItemContainerStyle="{DynamicResource ComboBoxItemStandard}" SelectionChanged="CmbAllType_SelectionChanged"/><Button Content="应用" Style="{DynamicResource ButtonPrimary}" Padding="18,9" Margin="8,0,0,0" Click="BtnApplyType_Click"/><TextBlock Text="全部长度" FontSize="13" Foreground="#4A5568" VerticalAlignment="Center" Margin="24,0,8,0"/><TextBox x:Name="TxtAllLength" Width="90" Height="40" Text="1000" Style="{DynamicResource TextBoxStandard}" TextChanged="TxtAllLength_TextChanged"/><Button Content="应用长度" Style="{DynamicResource ButtonPrimary}" Padding="18,9" Margin="8,0,0,0" Click="BtnApplyLength_Click"/>
                        <StackPanel Orientation="Horizontal" Margin="24,0,0,0">
                            <TextBlock Text="表名前缀" FontSize="13" Foreground="#4A5568" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox x:Name="TxtTablePrefix" Width="130" Height="40" Text="TJK_"
                                     Padding="10,4" VerticalContentAlignment="Center" Style="{DynamicResource TextBoxStandard}"
                                     TextChanged="TxtTablePrefix_TextChanged"
                                     ToolTip="自动拼接到解析出的表名前，清空则不添加前缀；修改后请重新生成 SQL。"/>
                            <Button Content="保存" Style="{DynamicResource ButtonPrimary}" Padding="18,9" Margin="8,0,0,0"
                                    Click="BtnSaveTablePrefix_Click" ToolTip="保存表名前缀，下次打开时自动恢复"/>
                        </StackPanel>
                    </WrapPanel>
                    <Border Background="#F8FAFC" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="0" Padding="0">
                        <DataGrid x:Name="GridColumns" Style="{DynamicResource QuickTableGridStyle}" AutoGenerateColumns="False" IsReadOnly="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False" CanUserResizeRows="False" EnableRowVirtualization="True" EnableColumnVirtualization="True" RowHeaderWidth="0" MaxHeight="430" MinHeight="180" Background="White" BorderThickness="0" GridLinesVisibility="All" HorizontalGridLinesBrush="#E4E7EB" VerticalGridLinesBrush="#E4E7EB" FontSize="12" ColumnHeaderHeight="38" HeadersVisibility="Column" RowBackground="White" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" SelectionUnit="CellOrRowHeader" SelectionMode="Extended">
                            <VirtualizingPanel.ScrollUnit>Pixel</VirtualizingPanel.ScrollUnit>
                            <VirtualizingPanel.VirtualizationMode>Recycling</VirtualizingPanel.VirtualizationMode>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="序号" Width="58" IsReadOnly="True"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border Background="#EEF4FF" CornerRadius="8" Padding="8,4" HorizontalAlignment="Center"><TextBlock Text="{Binding RowNumber}" Style="{DynamicResource QuickTableCellTextStyle}" Foreground="#2563C7"/></Border></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                <DataGridTextColumn Header="原字段名" Binding="{Binding OriginalName}" IsReadOnly="True" Width="*" MinWidth="150" ElementStyle="{DynamicResource QuickTableCellTextStyle}"/>
                                <DataGridTextColumn Header="生成字段名" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="*" MinWidth="150" ElementStyle="{DynamicResource QuickTableCellTextStyle}" EditingElementStyle="{StaticResource QuickTableEditingTextStyle}"/>
                                <DataGridTemplateColumn Header="类型" Width="120"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border Background="#EEF4FF" CornerRadius="6" Padding="8,4" HorizontalAlignment="Center"><TextBlock Text="{Binding Type}" Style="{DynamicResource QuickTableCellTextStyle}" Foreground="#2563C7"/></Border></DataTemplate></DataGridTemplateColumn.CellTemplate><DataGridTemplateColumn.CellEditingTemplate><DataTemplate><ComboBox SelectedItem="{Binding Type, UpdateSourceTrigger=PropertyChanged}" ItemsSource="{x:Static svc:QuickTableService.TypeChoices}" Style="{DynamicResource QuickTableEditComboStyle}" ItemContainerStyle="{DynamicResource ComboBoxItemStandard}"/></DataTemplate></DataGridTemplateColumn.CellEditingTemplate></DataGridTemplateColumn>
                                <DataGridTextColumn Header="长度" Binding="{Binding Length, UpdateSourceTrigger=PropertyChanged}" Width="78" ElementStyle="{DynamicResource QuickTableCellTextStyle}" EditingElementStyle="{StaticResource QuickTableEditingTextStyle}"/>
                                <DataGridTextColumn Header="精度" Binding="{Binding Precision, UpdateSourceTrigger=PropertyChanged}" Width="70" ElementStyle="{DynamicResource QuickTableCellTextStyle}" EditingElementStyle="{StaticResource QuickTableEditingTextStyle}"/>
                                <DataGridTextColumn Header="小数位" Binding="{Binding Scale, UpdateSourceTrigger=PropertyChanged}" Width="78" ElementStyle="{DynamicResource QuickTableCellTextStyle}" EditingElementStyle="{StaticResource QuickTableEditingTextStyle}"/>
                                <DataGridTemplateColumn Header="可空" Width="110"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding Nullable, UpdateSourceTrigger=PropertyChanged}" Content="允许为空" Foreground="#2563C7" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                    <Border Background="#F1F6FF" CornerRadius="8" Padding="12,9" Margin="0,10,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="ⓘ" FontSize="15" Foreground="#2563EB" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="提示：可直接编辑生成字段名、类型、长度、精度和可空属性，修改后会自动应用。" FontSize="12" Foreground="#6B82A8" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <Border Style="{DynamicResource CardBorder}" Padding="18">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="4. SQL 与导出" FontSize="16" FontWeight="SemiBold" Foreground="#2D3748"/>
                            <TextBlock Text="生成后可复制或导出为 .sql 文件" FontSize="12" Foreground="#9CA3AF" Margin="0,4,0,0"/>
                        </StackPanel>
                        <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                            <Button Content="生成 SQL" Style="{DynamicResource ButtonPrimary}" Padding="20,9" Click="BtnGenerate_Click"/>
                            <Button Content="复制" Style="{DynamicResource ButtonSecondary}" Padding="18,9" Margin="8,0,0,0" Click="BtnCopy_Click"/>
                            <Button Content="导出 .sql" Style="{DynamicResource ButtonSecondary}" Padding="18,9" Margin="8,0,0,0" Click="BtnExport_Click"/>
                        </WrapPanel>
                    </Grid>
                    <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="1">
                        <Grid Height="420" ClipToBounds="True">
                            <TextBox x:Name="TxtOutput" AcceptsReturn="True" IsReadOnly="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap" Style="{StaticResource SqlOutputBox}"/>
                            <controls:SqlSyntaxLayer Editor="{Binding ElementName=TxtOutput}" Margin="16,14"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
