<Page x:Class="WpfApp1.Views.DataValidationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:WpfApp1.Views"
      xmlns:conv="clr-namespace:WpfApp1.Converters"
      xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
      Background="{DynamicResource PageBackgroundAltBrush}"
      x:Name="PageRoot">

    <Page.Resources>
        <!-- 圆角输入框 -->
        <Style x:Key="RoundedInputBox" TargetType="TextBox" BasedOn="{StaticResource TextBoxStandard}"/>

        <Style x:Key="GridContextMenu" TargetType="ContextMenu">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D8E1F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="HasDropShadow" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.14" Color="#0F172A"/>
                            </Border.Effect>
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GridContextMenuItem" TargetType="MenuItem">
            <Setter Property="Foreground" Value="#1F2937"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,2,0,2"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#EEF2FF"/>
                                <Setter Property="Foreground" Value="#3152E0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ItemBorder" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ValidationOptionChip" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="ChipBorder"
                                Background="White"
                                BorderBrush="#DCE5F3"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="14,12"
                                Margin="0,0,12,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border x:Name="Dot"
                                        Width="10"
                                        Height="10"
                                        CornerRadius="5"
                                        Background="#CBD5E1"
                                        VerticalAlignment="Center"/>

                                <ContentPresenter Grid.Column="1"
                                                  Margin="10,0,12,0"
                                                  VerticalAlignment="Center"/>

                                <Border x:Name="StateBadge"
                                        Grid.Column="2"
                                        Background="#F8FAFC"
                                        BorderBrush="#E5E7EB"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="8,3"
                                        VerticalAlignment="Center">
                                    <TextBlock x:Name="StateText"
                                               Text="未启用"
                                               FontSize="11"
                                               Foreground="#94A3B8"/>
                                </Border>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ChipBorder" Property="BorderBrush" Value="#BFD0F6"/>
                                <Setter TargetName="ChipBorder" Property="Background" Value="#FAFCFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ChipBorder" Property="BorderBrush" Value="#6D7CF6"/>
                                <Setter TargetName="ChipBorder" Property="Background" Value="#F3F6FF"/>
                                <Setter TargetName="Dot" Property="Background" Value="#5B6EF5"/>
                                <Setter TargetName="StateBadge" Property="Background" Value="#E7EDFF"/>
                                <Setter TargetName="StateBadge" Property="BorderBrush" Value="#C7D2FE"/>
                                <Setter TargetName="StateText" Property="TextBlock.Text" Value="已启用"/>
                                <Setter TargetName="StateText" Property="Foreground" Value="#3F56E8"/>
                                <Setter Property="Foreground" Value="#3749D8"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ChipBorder" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── DataGrid 内嵌下拉框（紧凑圆角） ──────────────────── -->
        <Style x:Key="InlineCb" TargetType="ComboBox">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    BorderBrush="Transparent" BorderThickness="1" CornerRadius="6"
                                    Padding="6,3,22,3" SnapsToDevicePixels="True">
                                <ContentPresenter IsHitTestVisible="False"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <Path Data="M0,0 L3.5,3.5 L7,0" Stroke="#94A3B8" StrokeThickness="1.2"
                                  HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,7,0"
                                  Fill="Transparent" IsHitTestVisible="False"/>
                            <ToggleButton Opacity="0" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press" Focusable="False"/>
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                                   AllowsTransparency="True" PopupAnimation="Slide" Focusable="False">
                                <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1"
                                        CornerRadius="6" Margin="0,2,0,0" Padding="3"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}" MinWidth="{TemplateBinding ActualWidth}">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.10" Color="#000"/>
                                    </Border.Effect>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#CBD5E1"/>
                                <Setter TargetName="Bd" Property="Background" Value="#F8FAFC"/>
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#4E6EF2"/>
                                <Setter TargetName="Bd" Property="Background" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Resources>
                <Style TargetType="ComboBoxItem">
                    <Setter Property="Padding" Value="8,5"/>
                    <Setter Property="FontSize" Value="12"/>
                    <Setter Property="Foreground" Value="#374151"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ComboBoxItem">
                                <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                        CornerRadius="4" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsHighlighted" Value="True">
                                        <Setter TargetName="Bg" Property="Background" Value="#EEF2FF"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Bg" Property="Background" Value="#DBEAFE"/>
                                        <Setter Property="Foreground" Value="#1D4ED8"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Style.Resources>
        </Style>

        <!-- 页面专属列头（原始 Padding/字号与全局不同） -->
        <Style x:Key="DvHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource DataGridHeaderStyle}">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Padding" Value="10,9"/>
            <Setter Property="Height" Value="Auto"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="BorderBrush" Value="#EEF2F7"/>
        </Style>

        <Style x:Key="DvResizableHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource DvHeader}">
            <Style.Resources>
                <Style x:Key="DvHeaderGripper" TargetType="primitives:Thumb">
                    <Setter Property="Width" Value="8"/>
                    <Setter Property="Cursor" Value="SizeWE"/>
                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="primitives:Thumb">
                                <Border Background="Transparent"/>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Style.Resources>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Grid>
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            </Border>
                            <primitives:Thumb x:Name="PART_LeftHeaderGripper"
                                              HorizontalAlignment="Left"
                                              Style="{StaticResource DvHeaderGripper}"/>
                            <primitives:Thumb x:Name="PART_RightHeaderGripper"
                                              HorizontalAlignment="Right"
                                              Style="{StaticResource DvHeaderGripper}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DashboardPanel" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E5ECF7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
        </Style>

        <Style x:Key="MetricCard" TargetType="Border" BasedOn="{StaticResource DashboardPanel}">
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="Margin" Value="0,0,14,0"/>
        </Style>

        <Style x:Key="DashboardRuleSwitch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#172033"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="RuleBorder"
                                Background="White"
                                BorderBrush="#E7EDF5"
                                BorderThickness="0,0,0,1"
                                Padding="12,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Width="22"
                                        Height="22"
                                        CornerRadius="6"
                                        Background="#EFF6FF"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{TemplateBinding Tag}"
                                               Foreground="#4076EE"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>

                                <ContentPresenter Grid.Column="1"
                                                  Margin="10,0,16,0"
                                                  VerticalAlignment="Center"/>

                                <Border x:Name="SwitchTrack"
                                        Grid.Column="2"
                                        Width="34"
                                        Height="18"
                                        CornerRadius="9"
                                        Background="#CBD5E1"
                                        VerticalAlignment="Center">
                                    <Ellipse x:Name="SwitchThumb"
                                             Width="14"
                                             Height="14"
                                             Margin="2"
                                             Fill="White"
                                             HorizontalAlignment="Left"
                                             VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RuleBorder" Property="Background" Value="#F8FBFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SwitchTrack" Property="Background" Value="#4E6EF2"/>
                                <Setter TargetName="SwitchThumb" Property="HorizontalAlignment" Value="Right"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="RuleBorder" Property="Opacity" Value="0.48"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IssueTypePill" TargetType="Border">
            <Setter Property="Background" Value="#FEE2E2"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>

        <Style x:Key="FilterCombo" TargetType="ComboBox" BasedOn="{StaticResource ComboBoxStandard}">
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Width" Value="180"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="MaxDropDownHeight" Value="240"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource ComboBoxItemStandard}"/>
        </Style>

        <!-- 页面专属单元格（原始边框/间距与全局不同） -->
        <Style x:Key="DvCell" TargetType="DataGridCell" BasedOn="{StaticResource DataGridCellStyle}">
            <Setter Property="Background" Value="{Binding Background, RelativeSource={RelativeSource AncestorType=DataGridRow}}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#EEF2F7"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <!-- 映射表行样式（Height=42 以适配内嵌 ComboBox） -->
        <Style x:Key="DgMappingRow" TargetType="DataGridRow">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Background" Value="White"/>
            <Style.Triggers>
                <Trigger Property="AlternationIndex" Value="1">
                    <Setter Property="Background" Value="#FAFBFF"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F1F5FF"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#E8EEFF"/>
                </Trigger>
                <!-- 必填未映射行红色背景 -->
                <DataTrigger Binding="{Binding NeedsHighlight}" Value="True">
                    <Setter Property="Background" Value="#FEF2F2"/>
                </DataTrigger>
                <!-- UUID 类型行淡黄色提示 -->
                <DataTrigger Binding="{Binding NeedsUuidHighlight}" Value="True">
                    <Setter Property="Background" Value="#FEF9C3"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 错误列表行样式 -->
        <Style x:Key="DgIssueRow" TargetType="DataGridRow">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Background" Value="White"/>
            <Style.Triggers>
                <Trigger Property="AlternationIndex" Value="1">
                    <Setter Property="Background" Value="#FAFBFF"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F1F5FF"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#E8EEFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ── 值转换器 ──────────────────────────────────────── -->
        <conv:BoolVisConverter x:Key="BoolVis"/>
        <conv:BoolYesNoConverter x:Key="BoolYesNo"/>
        <conv:RequiredColorConverter x:Key="RequiredColor"/>
        <conv:IssueColorConverter x:Key="IssueColor"/>

        <!-- ── 步骤圆圈 ─────────────────────────────────────── -->
        <Style x:Key="StepCircle" TargetType="Border">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="CornerRadius" Value="15"/>
            <Setter Property="Background" Value="#D1D5DB"/>
        </Style>
        <Style x:Key="StepCircleActive" TargetType="Border" BasedOn="{StaticResource StepCircle}">
            <Setter Property="Background" Value="#4E6EF2"/>
        </Style>
        <Style x:Key="StepCircleDone" TargetType="Border" BasedOn="{StaticResource StepCircle}">
            <Setter Property="Background" Value="#10B981"/>
        </Style>
    </Page.Resources>

    <DockPanel Margin="24,16,24,20">

        <!-- ══ 页头 ══════════════════════════════════════════════ -->
        <StackPanel x:Name="WizardTitlePanel" DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock Text="数据验证排查" FontSize="22" FontWeight="Bold" Foreground="#111827"/>
            <TextBlock Text="粘贴建表语句和插入语句，自动完成字段映射与入库前校验，生成错误报告。"
                       Margin="0,4,0,0" FontSize="13" Foreground="#64748B"/>
        </StackPanel>

        <!-- ══ 步骤指示器 ════════════════════════════════════════ -->
        <Border x:Name="WizardStepPanel" DockPanel.Dock="Top" Style="{DynamicResource CardBorder}" Padding="20,14" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

                <!-- Step 1 -->
                <StackPanel HorizontalAlignment="Center" Width="80">
                    <Border x:Name="Step1Circle" Style="{StaticResource StepCircleActive}"
                            HorizontalAlignment="Center">
                        <TextBlock x:Name="Step1Num" Text="1" FontSize="13" FontWeight="Bold"
                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="Step1Label" Text="结构输入" FontSize="11" TextAlignment="Center"
                               Foreground="#4E6EF2" FontWeight="SemiBold" Margin="0,4,0,0"/>
                </StackPanel>

                <Border Width="60" Height="2" Background="#D1D5DB" VerticalAlignment="Center"
                        Margin="0,0,0,18" x:Name="Line12"/>

                <!-- Step 2 -->
                <StackPanel HorizontalAlignment="Center" Width="80">
                    <Border x:Name="Step2Circle" Style="{StaticResource StepCircle}"
                            HorizontalAlignment="Center">
                        <TextBlock x:Name="Step2Num" Text="2" FontSize="13" FontWeight="Bold"
                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="Step2Label" Text="数据输入" FontSize="11" TextAlignment="Center"
                               Foreground="#9CA3AF" Margin="0,4,0,0"/>
                </StackPanel>

                <Border Width="60" Height="2" Background="#D1D5DB" VerticalAlignment="Center"
                        Margin="0,0,0,18" x:Name="Line23"/>

                <!-- Step 3 -->
                <StackPanel HorizontalAlignment="Center" Width="80">
                    <Border x:Name="Step3Circle" Style="{StaticResource StepCircle}"
                            HorizontalAlignment="Center">
                        <TextBlock x:Name="Step3Num" Text="3" FontSize="13" FontWeight="Bold"
                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="Step3Label" Text="字段映射" FontSize="11" TextAlignment="Center"
                               Foreground="#9CA3AF" Margin="0,4,0,0"/>
                </StackPanel>

                <Border Width="60" Height="2" Background="#D1D5DB" VerticalAlignment="Center"
                        Margin="0,0,0,18" x:Name="Line34"/>

                <!-- Step 4 -->
                <StackPanel HorizontalAlignment="Center" Width="80">
                    <Border x:Name="Step4Circle" Style="{StaticResource StepCircle}"
                            HorizontalAlignment="Center">
                        <TextBlock x:Name="Step4Num" Text="4" FontSize="13" FontWeight="Bold"
                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="Step4Label" Text="校验结果" FontSize="11" TextAlignment="Center"
                               Foreground="#9CA3AF" Margin="0,4,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ══ 第 4 步专用结果页头 ════════════════════════════════ -->
        <Border x:Name="ResultHeaderPanel"
                DockPanel.Dock="Top"
                Visibility="Collapsed"
                Background="White"
                BorderBrush="#E1E8F2"
                BorderThickness="1"
                CornerRadius="10"
                Padding="18,14"
                Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="42"
                            Height="42"
                            CornerRadius="21"
                            Background="#EEF4FF"
                            BorderBrush="#CBDAFF"
                            BorderThickness="1"
                            Margin="0,0,12,0">
                        <TextBlock Text="🔎"
                                   Foreground="#4E6EF2"
                                   FontSize="18"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="数据验证排查"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="#111827"/>
                        <TextBlock Text="粘贴表结构或输入语句，自动完成字段映射与入库前校验，生成错误报告。"
                                   Margin="0,4,0,0"
                                   FontSize="12.5"
                                   Foreground="#7B8798"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="26,0,24,0">
                    <StackPanel HorizontalAlignment="Center" Width="80">
                        <Border Width="28" Height="28" CornerRadius="14" Background="#10B981" HorizontalAlignment="Center">
                            <TextBlock Text="✓" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="结构输入" Margin="0,5,0,0" FontSize="11" Foreground="#334155" TextAlignment="Center"/>
                    </StackPanel>
                    <Border Width="72" Height="1" Background="#10B981" Margin="0,0,0,18" VerticalAlignment="Center"/>
                    <StackPanel HorizontalAlignment="Center" Width="80">
                        <Border Width="28" Height="28" CornerRadius="14" Background="#10B981" HorizontalAlignment="Center">
                            <TextBlock Text="✓" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="数据输入" Margin="0,5,0,0" FontSize="11" Foreground="#334155" TextAlignment="Center"/>
                    </StackPanel>
                    <Border Width="72" Height="1" Background="#10B981" Margin="0,0,0,18" VerticalAlignment="Center"/>
                    <StackPanel HorizontalAlignment="Center" Width="80">
                        <Border Width="28" Height="28" CornerRadius="14" Background="#10B981" HorizontalAlignment="Center">
                            <TextBlock Text="✓" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="字段映射" Margin="0,5,0,0" FontSize="11" Foreground="#334155" TextAlignment="Center"/>
                    </StackPanel>
                    <Border Width="72" Height="1" Background="#10B981" Margin="0,0,0,18" VerticalAlignment="Center"/>
                    <StackPanel HorizontalAlignment="Center" Width="80">
                        <Border Width="28" Height="28" CornerRadius="14" Background="#4E6EF2" HorizontalAlignment="Center">
                            <TextBlock Text="4" FontSize="13" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="校验结果" Margin="0,5,0,0" FontSize="11" Foreground="#4E6EF2" FontWeight="SemiBold" TextAlignment="Center"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnRunValidation"
                            Content="▶ 开始校验"
                            Style="{DynamicResource ButtonPrimary}"
                            Padding="18,10"
                            MinWidth="128"
                            Margin="0,0,10,0"
                            Click="BtnRunValidation_Click"/>
                    <Button x:Name="BtnExportReport"
                            Content="▣ 导出 Excel 报告"
                            Style="{DynamicResource ButtonSuccess}"
                            Padding="18,10"
                            MinWidth="150"
                            Visibility="Collapsed"
                            Click="BtnExportReport_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══ 导航按钮行（固定底部）══════════════════════════════ -->
        <Border DockPanel.Dock="Bottom" Padding="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TxtStatus" Grid.Column="0" FontSize="12"
                           Foreground="#64748B" VerticalAlignment="Center"/>
                <Button x:Name="BtnBack" Grid.Column="1" Content="← 上一步"
                        Style="{DynamicResource ButtonGhost}" Margin="0,0,8,0"
                        Visibility="Collapsed" Click="BtnBack_Click"/>
                <Button x:Name="BtnNext" Grid.Column="2" Content="下一步 →"
                        Style="{DynamicResource ButtonPrimary}" Click="BtnNext_Click"/>
            </Grid>
        </Border>

        <!-- ══ 步骤内容区（填满剩余空间）══════════════════════════ -->
        <Border Style="{DynamicResource CardBorder}" Padding="24,20">
            <Grid x:Name="ContentArea">

                <!-- ─── Step 1：结构输入 ─────────────────────── -->
                <DockPanel x:Name="Panel1" Visibility="Visible">

                    <!-- DB类型 + 表名 -->
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="32"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="280"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="数据库类型" FontSize="13" FontWeight="SemiBold"
                                   Foreground="#374151" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <RadioButton x:Name="RbSqlServer" Content="SQL Server" GroupName="DbType"
                                         FontSize="13" Margin="0,0,16,0" Foreground="#374151"
                                         Checked="DbType_Changed"/>
                            <RadioButton x:Name="RbPostgreSql" Content="PostgreSQL" GroupName="DbType"
                                         IsChecked="True" FontSize="13" Foreground="#374151"
                                         Checked="DbType_Changed"/>
                        </StackPanel>
                        <TextBlock Grid.Column="3" Text="目标表名" FontSize="13" FontWeight="SemiBold"
                                   Foreground="#374151" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <TextBox x:Name="TxtTableName" Grid.Column="4" Style="{StaticResource RoundedInputBox}"/>
                    </Grid>

                    <Border DockPanel.Dock="Top" Height="1" Background="#E5E7EB" Margin="0,0,0,14"/>
                    <TextBlock DockPanel.Dock="Top" Text="结构输入方式" FontSize="13" FontWeight="SemiBold"
                               Foreground="#374151" Margin="0,0,0,10"/>

                    <!-- 两卡片区域，填满剩余高度 -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- DDL 模式卡片 -->
                        <Border x:Name="DdlCard" Grid.Column="0" CornerRadius="10" Padding="2"
                                Background="#4E6EF2" BorderThickness="0">
                            <Border CornerRadius="8" Background="White" Padding="18,16" BorderBrush="#E5E7EB" BorderThickness="1">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                                        <RadioButton x:Name="RbDdlMode" Content="DDL 建表语句（推荐）"
                                                     GroupName="StructMode" IsChecked="True"
                                                     FontSize="13" FontWeight="SemiBold" Foreground="#1E3A8A"
                                                     Checked="StructMode_Changed"/>
                                    </StackPanel>
                                    <TextBlock DockPanel.Dock="Top" Text="直接粘贴 CREATE TABLE 语句，表名和字段会自动解析"
                                               FontSize="12" Foreground="#64748B" Margin="0,0,0,8"/>
                                    <Grid DockPanel.Dock="Bottom" Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="TxtDdlStatus" Grid.Column="0"
                                                   FontSize="12" Foreground="#64748B" VerticalAlignment="Center"/>
                                        <Button Grid.Column="1" Content="清空" Style="{DynamicResource ButtonGhost}"
                                                Padding="10,6" FontSize="12" Margin="0,0,8,0"
                                                Click="BtnClearDdl_Click"/>
                                        <Button Grid.Column="2" Content="解析 DDL"
                                                Style="{DynamicResource ButtonPrimary}"
                                                Padding="14,7" FontSize="12"
                                                Click="BtnParseDdl_Click"/>
                                    </Grid>
                                    <Grid>
                                        <TextBox x:Name="TxtDdl" AcceptsReturn="True"
                                                 AcceptsTab="True" VerticalScrollBarVisibility="Auto"
                                                 HorizontalScrollBarVisibility="Auto"
                                                 Style="{DynamicResource TextBoxStandard}"
                                                 TextWrapping="NoWrap" FontFamily="Consolas" FontSize="12"/>
                                        <Border x:Name="DdlPasteOverlay" Visibility="Collapsed"
                                                Background="#E8EEFFCC" CornerRadius="4">
                                            <TextBlock Text="正在粘贴数据..." FontSize="14" FontWeight="SemiBold"
                                                       Foreground="#4E6EF2" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </Grid>
                                </DockPanel>
                            </Border>
                        </Border>

                        <!-- SQL 查询导入卡片 -->
                        <Border x:Name="StructExcelCard" Grid.Column="2" CornerRadius="10" Padding="0"
                                Background="Transparent" BorderThickness="0">
                            <Border x:Name="StructExcelInner" CornerRadius="8" Background="White" Padding="18,16"
                                    BorderBrush="#E5E7EB" BorderThickness="1">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                                        <RadioButton x:Name="RbExcelStructMode" Content="SQL 查询导入（备用）"
                                                     GroupName="StructMode" FontSize="13" FontWeight="SemiBold"
                                                     Foreground="#374151" Checked="StructMode_Changed"/>
                                    </StackPanel>
                                    <TextBlock DockPanel.Dock="Top" Text="在数据库中执行以下查询，将结果导出为 Excel 后导入"
                                               FontSize="12" Foreground="#64748B" Margin="0,0,0,8"/>
                                    <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="复制查询语句" Style="{DynamicResource ButtonGhost}"
                                                    Padding="10,5" FontSize="12" Margin="0,0,8,0"
                                                    Click="BtnCopyStructQuery_Click"/>
                                            <Button Content="导入结果 Excel" Style="{DynamicResource ButtonSecondary}"
                                                    Padding="10,5" FontSize="12"
                                                    Click="BtnImportStructExcel_Click"/>
                                        </StackPanel>
                                        <TextBlock x:Name="TxtStructExcelInfo" FontSize="12"
                                                   Foreground="#64748B" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <TextBox x:Name="TxtStructQuery" IsReadOnly="True"
                                             AcceptsReturn="True"
                                             Style="{DynamicResource TextBoxStandard}"
                                             TextWrapping="Wrap" FontFamily="Consolas" FontSize="11"
                                             Background="#F8FAFC" BorderBrush="#D1D5DB" BorderThickness="1"
                                             VerticalScrollBarVisibility="Auto" Padding="8,6"/>
                                </DockPanel>
                            </Border>
                        </Border>
                    </Grid>
                </DockPanel>

                <!-- ─── Step 2：数据输入 ─────────────────────── -->
                <DockPanel x:Name="Panel2" Visibility="Collapsed">
                    <TextBlock DockPanel.Dock="Top" Text="数据输入方式" FontSize="13" FontWeight="SemiBold"
                               Foreground="#374151" Margin="0,0,0,10"/>

                    <!-- 两卡片区域，填满剩余高度 -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- INSERT 模式 -->
                        <Border x:Name="InsertCard" Grid.Column="0" CornerRadius="10" Padding="2"
                                Background="#4E6EF2" BorderThickness="0">
                            <Border CornerRadius="8" Background="White" Padding="18,16">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                                        <RadioButton x:Name="RbInsertMode" Content="INSERT INTO 语句（推荐）"
                                                     GroupName="DataMode" IsChecked="True"
                                                     FontSize="13" FontWeight="SemiBold" Foreground="#1E3A8A"
                                                     Checked="DataMode_Changed"/>
                                    </StackPanel>
                                    <TextBlock DockPanel.Dock="Top" Text="直接粘贴 INSERT INTO 语句，支持单行/多行/多值组"
                                               FontSize="12" Foreground="#64748B" Margin="0,0,0,8"/>
                                    <Grid DockPanel.Dock="Bottom" Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="TxtInsertStatus" Grid.Column="0"
                                                   FontSize="12" Foreground="#64748B" VerticalAlignment="Center"/>
                                        <Button Grid.Column="1" Content="清空" Style="{DynamicResource ButtonGhost}"
                                                Padding="10,6" FontSize="12" Margin="0,0,8,0"
                                                Click="BtnClearInsert_Click"/>
                                        <Button Grid.Column="2" Content="解析 INSERT"
                                                Style="{DynamicResource ButtonPrimary}"
                                                Padding="14,7" FontSize="12"
                                                Click="BtnParseInsert_Click"/>
                                    </Grid>
                                    <Grid>
                                        <TextBox x:Name="TxtInsert" AcceptsReturn="True"
                                                 AcceptsTab="True" VerticalScrollBarVisibility="Auto"
                                                 HorizontalScrollBarVisibility="Auto"
                                                 Style="{DynamicResource TextBoxStandard}"
                                                 TextWrapping="NoWrap" FontFamily="Consolas" FontSize="12"/>
                                        <Border x:Name="InsertPasteOverlay" Visibility="Collapsed"
                                                Background="#E8EEFFCC" CornerRadius="4">
                                            <TextBlock Text="正在粘贴数据..." FontSize="14" FontWeight="SemiBold"
                                                       Foreground="#4E6EF2" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </Grid>
                                </DockPanel>
                            </Border>
                        </Border>

                        <!-- Excel 数据 -->
                        <Border x:Name="DataExcelCard" Grid.Column="2" CornerRadius="10" Padding="0"
                                Background="Transparent" BorderThickness="0">
                            <Border x:Name="DataExcelInner" CornerRadius="8" Background="White" Padding="18,16"
                                    BorderBrush="#E5E7EB" BorderThickness="1">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <RadioButton x:Name="RbExcelDataMode" Content="Excel 数据文件（备用）"
                                                     GroupName="DataMode" FontSize="13" FontWeight="SemiBold"
                                                     Foreground="#374151" Checked="DataMode_Changed"/>
                                    </StackPanel>
                                    <TextBlock Text="导入中间表数据 Excel，第一行必须为表头"
                                               FontSize="12" Foreground="#64748B" Margin="0,0,0,24"/>
                                    <Button Content="导入数据 Excel" Style="{DynamicResource ButtonSecondary}"
                                            Padding="16,9" FontSize="13" HorizontalAlignment="Left"
                                            Click="BtnImportDataExcel_Click"/>
                                    <TextBlock x:Name="TxtDataExcelInfo" FontSize="12"
                                               Foreground="#64748B" Margin="0,12,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </Border>
                    </Grid>
                </DockPanel>

                <!-- ─── Step 3：字段映射 ─────────────────────── -->
                <DockPanel x:Name="Panel3" Visibility="Collapsed" LastChildFill="True">

                    <!-- 主键选择 -->
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="中间表主键" FontSize="13" FontWeight="SemiBold"
                                   Foreground="#374151" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <ComboBox x:Name="CbPk1" Width="170" Margin="0,0,8,0"
                                  Style="{DynamicResource ComboBoxStandard}"
                                  ItemContainerStyle="{DynamicResource ComboBoxItemStandard}"
                                  MaxDropDownHeight="240"
                                  SelectionChanged="PrimaryKey_Changed"/>
                        <ComboBox x:Name="CbPk2" Width="170" Margin="0,0,12,0"
                                  Style="{DynamicResource ComboBoxStandard}"
                                  ItemContainerStyle="{DynamicResource ComboBoxItemStandard}"
                                  MaxDropDownHeight="240"
                                  SelectionChanged="PrimaryKey_Changed"/>
                        <TextBlock Text="(选填，用于错误报告中按主键定位记录)" FontSize="11"
                                   Foreground="#9CA3AF" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- 工具栏 -->
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="#1F2937">
                                <Run Text="字段映射配置"/>
                                <Run x:Name="RunMappingInfo" Text="" Foreground="#6B7280" FontWeight="Normal" FontSize="12"/>
                            </TextBlock>
                            <TextBlock x:Name="TxtMappingHint" FontSize="12" Foreground="#EF4444"
                                       Margin="0,2,0,0" Visibility="Collapsed"
                                       Text="存在待处理映射，请先处理高亮行后再继续"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="忽略自动生成UUID" Style="{DynamicResource ButtonGhost}"
                                    Padding="12,7" FontSize="12" Margin="0,0,8,0"
                                    Click="BtnIgnoreAllUuid_Click"/>
                            <Button Content="重新自动映射" Style="{DynamicResource ButtonGhost}"
                                    Padding="12,7" FontSize="12" Margin="0,0,8,0"
                                    Click="BtnAutoMap_Click"/>
                            <Button x:Name="BtnNextUnconfirmed" Content="↓ 未确认" Style="{DynamicResource ButtonGhost}"
                                    Padding="12,7" FontSize="12" Margin="0,0,8,0"
                                    Click="BtnNextUnconfirmed_Click"/>
                            <Button Content="全部确认" Style="{DynamicResource ButtonSuccess}"
                                    Padding="12,7" FontSize="12"
                                    Click="BtnConfirmAll_Click"/>
                        </StackPanel>
                    </Grid>

                    <!-- 字段映射 DataGrid -->
                    <Border BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="0">
                        <DataGrid x:Name="DgMapping"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  CanUserReorderColumns="False"
                                  CanUserSortColumns="False"
                                  CanUserResizeColumns="True"
                                  CanUserResizeRows="False"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#EEF2F7"
                                  BorderThickness="0"
                                  Background="White"
                                  AlternationCount="2"
                                  ColumnHeaderStyle="{StaticResource DvResizableHeader}"
                                  CellStyle="{StaticResource DvCell}"
                                  RowStyle="{StaticResource DgMappingRow}"
                                  SelectionMode="Single"
                                  SelectionUnit="FullRow"
                                  VerticalScrollBarVisibility="Auto"
                                  FontSize="12"
                                  PreviewKeyDown="DataGrid_PreviewKeyDown"
                                  PreviewMouseRightButtonDown="DataGrid_PreviewMouseRightButtonDown">
                            <DataGrid.ContextMenu>
                                <ContextMenu Style="{StaticResource GridContextMenu}">
                                    <MenuItem Header="复制当前单元格"
                                              Style="{StaticResource GridContextMenuItem}"
                                              Click="CopyCurrentCellMenu_Click"/>
                                    <MenuItem Header="复制当前行"
                                              Style="{StaticResource GridContextMenuItem}"
                                              Click="CopyCurrentRowMenu_Click"/>
                                </ContextMenu>
                            </DataGrid.ContextMenu>
                            <DataGrid.Columns>

                                <!-- 序号 -->
                                <DataGridTextColumn Header="#" Binding="{Binding RowIndex}"
                                                    Width="42" IsReadOnly="True"/>

                                <!-- 目标字段 -->
                                <DataGridTextColumn Header="目标字段" Binding="{Binding TargetColumnName}"
                                                    Width="120" IsReadOnly="True"/>

                                <!-- 类型 -->
                                <DataGridTextColumn Header="目标类型" Binding="{Binding TargetDisplayType}"
                                                    Width="110" IsReadOnly="True"/>

                                <!-- 必填 -->
                                <DataGridTemplateColumn Header="必填" Width="48" IsReadOnly="True">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding IsRequired, Converter={StaticResource BoolYesNo}}"
                                                       Foreground="{Binding IsRequired, Converter={StaticResource RequiredColor}}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       FontSize="13" FontWeight="SemiBold"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- 映射方式 -->
                                <DataGridTemplateColumn Header="映射方式" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox Style="{StaticResource InlineCb}"
                                                      SelectedItem="{Binding MappingTypeStr, UpdateSourceTrigger=PropertyChanged}"
                                                      ItemsSource="{Binding DataContext.MappingTypeOptions, RelativeSource={RelativeSource AncestorType=Page}}"
                                                      SelectionChanged="MappingType_Changed"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- 来源/值（动态） -->
                                <DataGridTemplateColumn Header="来源字段 / 固定值" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <!-- Source: ComboBox -->
                                                <ComboBox Style="{StaticResource InlineCb}"
                                                          Visibility="{Binding IsSourceMode, Converter={StaticResource BoolVis}}"
                                                          SelectedItem="{Binding SourceColumnName, UpdateSourceTrigger=PropertyChanged}"
                                                          ItemsSource="{Binding DataContext.SourceHeaders, RelativeSource={RelativeSource AncestorType=Page}}"
                                                          SelectionChanged="SourceColumn_Changed"/>
                                                <!-- Constant: TextBox -->
                                                <TextBox Visibility="{Binding IsConstantMode, Converter={StaticResource BoolVis}}"
                                                         Text="{Binding ConstantValue, UpdateSourceTrigger=PropertyChanged}"
                                                         TextChanged="ConstantValue_Changed"
                                                         BorderThickness="0" Background="Transparent" FontSize="12" Padding="4,2"/>
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- 匹配方式 -->
                                <DataGridTextColumn Header="匹配方式" Binding="{Binding MatchMethodText}"
                                                    Width="80" IsReadOnly="True"/>

                                <!-- 命中原因 -->
                                <DataGridTextColumn Header="命中原因" Binding="{Binding MatchReasonText}"
                                                    Width="220" IsReadOnly="True"/>

                                <!-- 置信度 -->
                                <DataGridTextColumn Header="置信度" Binding="{Binding ConfidenceText}"
                                                    Width="60" IsReadOnly="True"/>

                                <!-- 已确认 -->
                                <DataGridTemplateColumn Header="已确认" Width="60">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsConfirmed, UpdateSourceTrigger=PropertyChanged}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </DockPanel>

                <!-- ─── Step 4：校验结果 ─────────────────────── -->
                <DockPanel x:Name="Panel4" Visibility="Collapsed" LastChildFill="True">

                    <Border x:Name="ExportStatusPanel"
                            DockPanel.Dock="Bottom"
                            Visibility="Collapsed"
                            Background="#F8FBFF"
                            BorderBrush="#D8E6FF"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12,9"
                            Margin="0,12,0,0">
                        <TextBlock FontSize="12.5" Foreground="#334155" VerticalAlignment="Center">
                            <Run Text="报告已导出："/>
                            <Hyperlink Click="ExportedReportLink_Click">
                                <Run x:Name="RunExportedReportName" Text=""/>
                            </Hyperlink>
                        </TextBlock>
                    </Border>

                    <Border x:Name="SummaryCard"
                            DockPanel.Dock="Top"
                            Visibility="Collapsed"
                            Background="Transparent"
                            BorderThickness="0"
                            Margin="0,0,0,12">
                        <UniformGrid Columns="5">
                            <Border Style="{StaticResource MetricCard}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="46"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="40" Height="40" CornerRadius="20" Background="#EAF1FF">
                                        <TextBlock Text="📋" Foreground="#4076EE" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                        <TextBlock Text="总记录数" FontSize="11.5" Foreground="#64748B"/>
                                        <TextBlock x:Name="TxtTotalRows" Text="0" Margin="0,6,0,0" FontSize="22" FontWeight="Bold" Foreground="#172033"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource MetricCard}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="46"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="40" Height="40" CornerRadius="20" Background="#FFE9E9">
                                        <TextBlock Text="❗" Foreground="#EF4444" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                        <TextBlock Text="异常记录数" FontSize="11.5" Foreground="#64748B"/>
                                        <TextBlock x:Name="TxtErrorCount" Text="0" Margin="0,6,0,0" FontSize="22" FontWeight="Bold" Foreground="#EF4444"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource MetricCard}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="46"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="40" Height="40" CornerRadius="20" Background="#FFF4D7">
                                        <TextBlock Text="❌" Foreground="#F59E0B" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                        <TextBlock Text="错误项数" FontSize="11.5" Foreground="#64748B"/>
                                        <TextBlock x:Name="TxtRawErrorCount" Text="0" Margin="0,6,0,0" FontSize="22" FontWeight="Bold" Foreground="#F59E0B"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource MetricCard}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="46"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="40" Height="40" CornerRadius="20" Background="#F0E9FF">
                                        <TextBlock Text="🚫" Foreground="#7C3AED" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                        <TextBlock Text="警告记录数" FontSize="11.5" Foreground="#64748B"/>
                                        <TextBlock x:Name="TxtWarningCount" Text="0" Margin="0,6,0,0" FontSize="22" FontWeight="Bold" Foreground="#7C3AED"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource DashboardPanel}" Padding="16,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="46"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="40" Height="40" CornerRadius="20" Background="#E7F8F0">
                                        <TextBlock Text="🕛" Foreground="#059669" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                        <TextBlock Text="耗时" FontSize="11.5" Foreground="#64748B"/>
                                        <TextBlock x:Name="TxtElapsed" Text="0.0s" Margin="0,6,0,0" FontSize="22" FontWeight="Bold" Foreground="#172033"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </UniformGrid>
                    </Border>

                    <Border x:Name="ProgressPanel"
                            DockPanel.Dock="Top"
                            Visibility="Collapsed"
                            Background="#EEF2FF"
                            BorderBrush="#DDE5FF"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="16,12"
                            Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock x:Name="TxtProgress"
                                           Text="校验中..."
                                           FontSize="13"
                                           Foreground="#1E3A8A"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,8"/>
                                <ProgressBar x:Name="PbProgress"
                                             Height="8"
                                             Value="0"
                                             Maximum="100"
                                             Background="#CBD5E1"
                                             Foreground="#4E6EF2"/>
                            </StackPanel>
                            <Button x:Name="BtnCancelValidation"
                                    Grid.Column="1"
                                    Content="取消"
                                    Style="{DynamicResource ButtonGhost}"
                                    Padding="14,6"
                                    FontSize="12"
                                    Margin="14,0,0,0"
                                    VerticalAlignment="Center"
                                    Click="BtnCancelValidation_Click"/>
                        </Grid>
                    </Border>

                    <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.18*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Style="{StaticResource DashboardPanel}"
                                Padding="16,14"
                                Margin="0,0,12,0">
                            <StackPanel>
                                <DockPanel LastChildFill="True">
                                    <TextBlock Text="校验规则"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               Foreground="#172033"/>
                                    <TextBlock Text="仅影响格式校验，适合在明确了解数据来源时临时放宽。"
                                               Margin="12,2,0,0"
                                               FontSize="11.5"
                                               Foreground="#8291A7"/>
                                </DockPanel>

                                <Border BorderBrush="#E7EDF5"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Margin="0,12,0,0"
                                        ClipToBounds="True">
                                    <StackPanel>
                                        <CheckBox x:Name="ChkSkipIntFormat"
                                                  Style="{StaticResource DashboardRuleSwitch}"
                                                  Tag="✏️"
                                                  IsChecked="True"
                                                  ToolTip="存储过程会做类型转换时可勾选，跳过整数/长整数格式校验">
                                            <StackPanel>
                                                <TextBlock Text="忽略整数格式错误" FontWeight="SemiBold" Foreground="#172033"/>
                                                <TextBlock Text="忽略整数值字段的格式错误" Margin="0,2,0,0" FontSize="11" Foreground="#8291A7"/>
                                            </StackPanel>
                                        </CheckBox>
                                        <CheckBox x:Name="ChkSkipUuidFormat"
                                                  Style="{StaticResource DashboardRuleSwitch}"
                                                  Tag="✏️"
                                                  IsChecked="False"
                                                  ToolTip="勾选后将跳过 UUID / UNIQUEIDENTIFIER 字段的格式错误校验">
                                            <StackPanel>
                                                <TextBlock Text="忽略 UUID 格式错误" FontWeight="SemiBold" Foreground="#172033"/>
                                                <TextBlock Text="忽略非 UUID 字符串的格式错误" Margin="0,2,0,0" FontSize="11" Foreground="#8291A7"/>
                                            </StackPanel>
                                        </CheckBox>
                                        <CheckBox x:Name="ChkSkipDateTimeFormat"
                                                  Style="{StaticResource DashboardRuleSwitch}"
                                                  Tag="✏️"
                                                  IsChecked="False"
                                                  ToolTip="勾选后将跳过 datetime / timestamp 等字段的日期时间格式错误校验">
                                            <StackPanel>
                                                <TextBlock Text="忽略日期时间格式错误" FontWeight="SemiBold" Foreground="#172033"/>
                                                <TextBlock Text="忽略非日期时间导致的格式错误" Margin="0,2,0,0" FontSize="11" Foreground="#8291A7"/>
                                            </StackPanel>
                                        </CheckBox>
                                        <CheckBox x:Name="ChkSkipActualValues"
                                                  Style="{StaticResource DashboardRuleSwitch}"
                                                  Tag="✏️"
                                                  IsChecked="True"
                                                  BorderThickness="0"
                                                  ToolTip="勾选后，命中下方列表的实际值将跳过类型和格式校验">
                                            <StackPanel>
                                                <TextBlock Text="忽略指定实际值" FontWeight="SemiBold" Foreground="#172033"/>
                                                <TextBlock Text="对指定值不进行格式校验" Margin="0,2,0,0" FontSize="11" Foreground="#8291A7"/>
                                            </StackPanel>
                                        </CheckBox>
                                    </StackPanel>
                                </Border>

                                <DockPanel Margin="0,14,0,8" LastChildFill="True">
                                    <TextBlock Text="忽略值设置"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="#172033"/>
                                    <TextBlock Text="输入多个值用逗号、分号、换行或空格分隔，空白值仍按必填校验。"
                                               Margin="12,1,0,0"
                                               FontSize="11"
                                               Foreground="#8291A7"/>
                                </DockPanel>

                                <Border BorderBrush="#E1E8F2" BorderThickness="1" CornerRadius="8" Padding="10,8">
                                    <DockPanel LastChildFill="True">
                                        <Button x:Name="BtnClearIgnoredActualValues"
                                                DockPanel.Dock="Right"
                                                Content="清空"
                                                Style="{DynamicResource ButtonGhost}"
                                                Padding="12,6"
                                                FontSize="12"
                                                Margin="8,0,0,0"
                                                Click="BtnClearIgnoredActualValues_Click"/>
                                        <Button x:Name="BtnAddSelectedActualValue"
                                                DockPanel.Dock="Right"
                                                Content="加入选中实际值"
                                                Style="{DynamicResource ButtonGhost}"
                                                Padding="12,6"
                                                FontSize="12"
                                                Margin="8,0,0,0"
                                                Click="BtnAddSelectedActualValue_Click"/>
                                        <WrapPanel VerticalAlignment="Center">
                                            <ItemsControl x:Name="IgnoredValuesItems">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="#F3F6FC"
                                                                BorderBrush="#DCE5F3"
                                                                BorderThickness="1"
                                                                CornerRadius="7"
                                                                Padding="8,4"
                                                                Margin="0,0,6,6">
                                                            <DockPanel LastChildFill="False">
                                                                <TextBlock Text="{Binding}"
                                                                           FontSize="12"
                                                                           Foreground="#334155"
                                                                           VerticalAlignment="Center"/>
                                                                <Button Content="×"
                                                                        Tag="{Binding}"
                                                                        Width="18"
                                                                        Height="18"
                                                                        Margin="4,0,0,0"
                                                                        Padding="0"
                                                                        FontSize="12"
                                                                        Foreground="#94A3B8"
                                                                        Background="Transparent"
                                                                        BorderThickness="0"
                                                                        Cursor="Hand"
                                                                        Click="IgnoredValueTagRemove_Click"/>
                                                            </DockPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </WrapPanel>
                                        <TextBox x:Name="TxtIgnoredActualValues"
                                                 Text="-"
                                                 Visibility="Collapsed"/>
                                    </DockPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1"
                                Style="{StaticResource DashboardPanel}"
                                Padding="16,14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0"
                                           Text="错误统计（按错误类型）"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="#172033"/>
                                <Grid Grid.Row="1" Margin="0,16,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid Width="210" Height="210" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Canvas x:Name="IssueChartCanvas"
                                                Width="190"
                                                Height="190"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"/>
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock x:Name="TxtIssueChartTotal"
                                                       Text="0"
                                                       FontSize="20"
                                                       FontWeight="SemiBold"
                                                       Foreground="#172033"
                                                       HorizontalAlignment="Center"/>
                                            <TextBlock Text="总错误"
                                                       Margin="0,4,0,0"
                                                       FontSize="11.5"
                                                       Foreground="#64748B"
                                                       HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>
                                    <ItemsControl x:Name="IssueTypeStatsItems"
                                                  Grid.Column="1"
                                                  VerticalAlignment="Center">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="#E7EDF5"
                                                        BorderThickness="0,0,0,1"
                                                        Padding="0,11">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="64"/>
                                                            <ColumnDefinition Width="82"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Ellipse Width="8" Height="8" Fill="{Binding Brush}" Margin="0,0,8,0"/>
                                                            <TextBlock Text="{Binding ErrorType}" FontSize="12.5" Foreground="#334155"/>
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding Count}"
                                                                   FontSize="12.5"
                                                                   Foreground="#EF4444"
                                                                   HorizontalAlignment="Right"
                                                                   VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="2"
                                                                   Text="{Binding PercentageText}"
                                                                   FontSize="12.5"
                                                                   Foreground="#8291A7"
                                                                   HorizontalAlignment="Right"
                                                                   VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                                <Border Grid.Row="2"
                                        Background="#F1F7FF"
                                        BorderBrush="#B7D3FF"
                                        BorderThickness="1"
                                        CornerRadius="7"
                                        Padding="10,8">
                                    <TextBlock Text="提示：当前只统计错误项，不包含已被忽略的项。"
                                               FontSize="11.5"
                                               Foreground="#4076EE"/>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- 错误列表 DataGrid -->
                    <Border Style="{StaticResource DashboardPanel}" Padding="12">
                        <DockPanel LastChildFill="True">
                            <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="错误明细"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               Foreground="#172033"/>
                                    <TextBlock x:Name="TxtIssueVisibleCount"
                                               Text="共 0 条"
                                               Margin="14,2,0,0"
                                               FontSize="12"
                                               Foreground="#64748B"/>
                                </StackPanel>
                                <ComboBox x:Name="CbIssueTypeFilter"
                                          Grid.Column="1"
                                          Style="{StaticResource FilterCombo}"
                                          SelectionChanged="CbIssueTypeFilter_SelectionChanged"
                                          Margin="0,0,10,0"/>
                                <TextBox x:Name="TxtIssueSearch"
                                         Grid.Column="2"
                                         Width="240"
                                         Style="{StaticResource RoundedInputBox}"
                                         Padding="10,5"
                                         FontSize="12"
                                         VerticalContentAlignment="Center"
                                         ToolTip="输入关键词搜索"
                                         TextChanged="TxtIssueSearch_TextChanged"
                                         Margin="0,0,10,0"/>
                                <Button x:Name="BtnRefreshIssueView"
                                        Grid.Column="3"
                                        Content="⟳ 刷新"
                                        Style="{DynamicResource ButtonGhost}"
                                        Padding="14,8"
                                        FontSize="12"
                                        Click="BtnRefreshIssueView_Click"/>
                            </Grid>
                            <DataGrid x:Name="DgIssues"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      CanUserReorderColumns="False"
                                      CanUserSortColumns="True"
                                      CanUserResizeColumns="True"
                                      CanUserResizeRows="False"
                                      IsReadOnly="True"
                                      GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="#EEF2F7"
                                      BorderBrush="#E7EDF5"
                                      BorderThickness="1"
                                      Background="White"
                                      AlternationCount="2"
                                      ColumnHeaderStyle="{StaticResource DvResizableHeader}"
                                      CellStyle="{StaticResource DvCell}"
                                      RowStyle="{StaticResource DgIssueRow}"
                                      SelectionMode="Single"
                                      SelectionUnit="FullRow"
                                      VerticalScrollBarVisibility="Auto"
                                      FontSize="12"
                                      PreviewKeyDown="DataGrid_PreviewKeyDown"
                                      PreviewMouseRightButtonDown="DataGrid_PreviewMouseRightButtonDown">
                                <DataGrid.ContextMenu>
                                    <ContextMenu Style="{StaticResource GridContextMenu}">
                                        <MenuItem Header="复制当前单元格"
                                                  Style="{StaticResource GridContextMenuItem}"
                                                  Click="CopyCurrentCellMenu_Click"/>
                                        <MenuItem Header="复制当前行"
                                                  Style="{StaticResource GridContextMenuItem}"
                                                  Click="CopyCurrentRowMenu_Click"/>
                                    </ContextMenu>
                                </DataGrid.ContextMenu>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="#" Binding="{Binding RowNumber}" Width="52"/>
                                    <DataGridTextColumn Header="主键" Binding="{Binding PrimaryKeyDisplay}" Width="180"/>
                                    <DataGridTextColumn Header="源字段" Binding="{Binding SourceColumnName}" Width="120"/>
                                    <DataGridTextColumn Header="目标字段" Binding="{Binding TargetColumnName}" Width="130"/>
                                    <DataGridTextColumn Header="目标类型" Binding="{Binding TargetDataType}" Width="120"/>
                                    <DataGridTemplateColumn Header="错误类型" Width="160" SortMemberPath="ErrorType">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource IssueTypePill}">
                                                    <TextBlock Text="{Binding ErrorType}"
                                                               FontSize="11.5"
                                                               FontWeight="SemiBold"
                                                               Foreground="#EF4444"/>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="实际值" Binding="{Binding ActualValue}" Width="140"/>
                                    <DataGridTextColumn Header="说明" Binding="{Binding Message}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>
                </DockPanel>

            </Grid>
        </Border>
    </DockPanel>
</Page>

