<Page x:Class="WpfApp1.Views.DataValidationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:WpfApp1.Views"
      xmlns:conv="clr-namespace:WpfApp1.Converters"
      Background="{DynamicResource PageBackgroundAltBrush}"
      x:Name="PageRoot">

    <Page.Resources>
        <!-- 圆角输入框 -->
        <Style x:Key="RoundedInputBox" TargetType="TextBox" BasedOn="{StaticResource TextBoxStandard}"/>

        <Style x:Key="GridContextMenu" TargetType="ContextMenu">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D8E1F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="HasDropShadow" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.14" Color="#0F172A"/>
                            </Border.Effect>
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GridContextMenuItem" TargetType="MenuItem">
            <Setter Property="Foreground" Value="#1F2937"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,2,0,2"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#EEF2FF"/>
                                <Setter Property="Foreground" Value="#3152E0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ItemBorder" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ValidationOptionChip" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="ChipBorder"
                                Background="White"
                                BorderBrush="#DCE5F3"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="14,12"
                                Margin="0,0,12,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border x:Name="Dot"
                                        Width="10"
                                        Height="10"
                                        CornerRadius="5"
                                        Background="#CBD5E1"
                                        VerticalAlignment="Center"/>

                                <ContentPresenter Grid.Column="1"
                                                  Margin="10,0,12,0"
                                                  VerticalAlignment="Center"/>

                                <Border x:Name="StateBadge"
                                        Grid.Column="2"
                                        Background="#F8FAFC"
                                        BorderBrush="#E5E7EB"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="8,3"
                                        VerticalAlignment="Center">
                                    <TextBlock x:Name="StateText"
                                               Text="未启用"
                                               FontSize="11"
                                               Foreground="#94A3B8"/>
                                </Border>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ChipBorder" Property="BorderBrush" Value="#BFD0F6"/>
                                <Setter TargetName="ChipBorder" Property="Background" Value="#FAFCFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ChipBorder" Property="BorderBrush" Value="#6D7CF6"/>
                                <Setter TargetName="ChipBorder" Property="Background" Value="#F3F6FF"/>
                                <Setter TargetName="Dot" Property="Background" Value="#5B6EF5"/>
                                <Setter TargetName="StateBadge" Property="Background" Value="#E7EDFF"/>
                                <Setter TargetName="StateBadge" Property="BorderBrush" Value="#C7D2FE"/>
                                <Setter TargetName="StateText" Property="TextBlock.Text" Value="已启用"/>
                                <Setter TargetName="StateText" Property="Foreground" Value="#3F56E8"/>
                                <Setter Property="Foreground" Value="#3749D8"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ChipBorder" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── DataGrid 内嵌下拉框（紧凑圆角） ──────────────────── -->
        <Style x:Key="InlineCb" TargetType="ComboBox">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    BorderBrush="Transparent" BorderThickness="1" CornerRadius="6"
                                    Padding="6,3" SnapsToDevicePixels="True">
                                <ContentPresenter IsHitTestVisible="False"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <Path Data="M0,0 L3.5,3.5 L7,0" Stroke="#94A3B8" StrokeThickness="1.2"
                                  HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,7,0"
                                  Fill="Transparent" IsHitTestVisible="False"/>
                            <ToggleButton Opacity="0" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press" Focusable="False"/>
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                                   AllowsTransparency="True" PopupAnimation="Slide" Focusable="False">
                                <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1"
                                        CornerRadius="6" Margin="0,2,0,0" Padding="3"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}" MinWidth="{TemplateBinding ActualWidth}">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.10" Color="#000"/>
                                    </Border.Effect>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#CBD5E1"/>
                                <Setter TargetName="Bd" Property="Background" Value="#F8FAFC"/>
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#4E6EF2"/>
                                <Setter TargetName="Bd" Property="Background" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Resources>
                <Style TargetType="ComboBoxItem">
                    <Setter Property="Padding" Value="8,5"/>
                    <Setter Property="FontSize" Value="12"/>
                    <Setter Property="Foreground" Value="#374151"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ComboBoxItem">
                                <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                        CornerRadius="4" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsHighlighted" Value="True">
                                        <Setter TargetName="Bg" Property="Background" Value="#EEF2FF"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Bg" Property="Background" Value="#DBEAFE"/>
                                        <Setter Property="Foreground" Value="#1D4ED8"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Style.Resources>
        </Style>

        <Style x:Key="DashboardPanel" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E5ECF7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
        </Style>

        <Style x:Key="MetricCard" TargetType="Border" BasedOn="{StaticResource DashboardPanel}">
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="Margin" Value="0,0,14,0"/>
        </Style>

        <Style x:Key="DashboardRuleSwitch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#172033"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="RuleBorder"
                                Background="White"
                                BorderBrush="#E7EDF5"
                                BorderThickness="0,0,0,1"
                                Padding="12,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Width="22"
                                        Height="22"
                                        CornerRadius="6"
                                        Background="#EFF6FF"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{TemplateBinding Tag}"
                                               Foreground="#4076EE"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>

                                <ContentPresenter Grid.Column="1"
                                                  Margin="10,0,16,0"
                                                  VerticalAlignment="Center"/>

                                <Border x:Name="SwitchTrack"
                                        Grid.Column="2"
                                        Width="34"
                                        Height="18"
                                        CornerRadius="9"
                                        Background="#CBD5E1"
                                        VerticalAlignment="Center">
                                    <Ellipse x:Name="SwitchThumb"
                                             Width="14"
                                             Height="14"
                                             Margin="2"
                                             Fill="White"
                                             HorizontalAlignment="Left"
                                             VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RuleBorder" Property="Background" Value="#F8FBFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SwitchTrack" Property="Background" Value="#4E6EF2"/>
                                <Setter TargetName="SwitchThumb" Property="HorizontalAlignment" Value="Right"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="RuleBorder" Property="Opacity" Value="0.48"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IssueTypePill" TargetType="Border">
            <Setter Property="Background" Value="#FEE2E2"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>

        <Style x:Key="FilterCombo" TargetType="ComboBox" BasedOn="{StaticResource ComboBoxStandard}">
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Width" Value="180"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="MaxDropDownHeight" Value="240"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource ComboBoxItemStandard}"/>
        </Style>

        <Style x:Key="DebugToggleButton" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="DebugBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="DebugBorder" Property="Background" Value="#EEF2FF"/>
                                <Setter TargetName="DebugBorder" Property="BorderBrush" Value="#A5B4FC"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="DebugBorder" Property="Background" Value="#E0E7FF"/>
                                <Setter TargetName="DebugBorder" Property="BorderBrush" Value="#4E6EF2"/>
                                <Setter Property="Foreground" Value="#3152E0"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="DebugBorder" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 映射表行样式 -->
        <Style x:Key="DgMappingRow" TargetType="DataGridRow" BasedOn="{StaticResource DataGridRowStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding NeedsHighlight}" Value="True">
                    <Setter Property="Background" Value="#FEF2F2"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding NeedsUuidHighlight}" Value="True">
                    <Setter Property="Background" Value="#FEF9C3"/>
                </DataTrigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#F0F7FF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DataImportNote" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#8392AA"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="8,4,0,0"/>
        </Style>

        <Style x:Key="StructureCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E7EEF8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16"/>
        </Style>
        <Style x:Key="StructureModeRadio" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#263D5C"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="16" Height="16" Margin="0,0,10,0">
                                <Ellipse x:Name="Ring" Fill="White" Stroke="#C4D0E3" StrokeThickness="1.5"/>
                                <Ellipse x:Name="Dot" Width="5" Height="5" Fill="White" Visibility="Collapsed"/>
                            </Grid>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Ring" Property="Fill" Value="#1665FF"/>
                                <Setter TargetName="Ring" Property="Stroke" Value="#1665FF"/>
                                <Setter TargetName="Dot" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="StructureEditor" TargetType="TextBox">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Padding" Value="10,12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="StructureOutlineButton" TargetType="Button" BasedOn="{StaticResource ButtonGhost}">
            <Setter Property="Foreground" Value="#526680"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="White" BorderBrush="#DCE5F2" BorderThickness="1"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#F0F7FF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MappingCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="BorderBrush" Value="#EAF1FB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,14"/>
        </Style>
        <Style x:Key="MappingPkCombo" TargetType="ComboBox" BasedOn="{StaticResource ComboBoxStandard}">
            <Setter Property="Background" Value="#FBFDFF"/>
            <Setter Property="BorderBrush" Value="#DFE9F7"/>
            <Setter Property="MinHeight" Value="34"/>
        </Style>
        <Style x:Key="MappingToolbarButton" TargetType="Button" BasedOn="{StaticResource ButtonGhost}">
            <Setter Property="Background" Value="#EEF4FB"/>
            <Setter Property="Foreground" Value="#385B89"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="MappingInlineCombo" TargetType="ComboBox" BasedOn="{StaticResource InlineCb}">
            <Setter Property="Foreground" Value="#347FFF"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="MappingFieldText" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="MappingEditButton" TargetType="Button" BasedOn="{StaticResource ButtonGhost}">
            <Setter Property="Foreground" Value="#347FFF"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="EditBorder" BorderBrush="#B6D0FF" BorderThickness="1" Background="White" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="EditBorder" Property="Background" Value="#EFF6FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MappingConfirmed" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTip" Value="确认 / 取消确认此映射"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Dot" Width="18" Height="18" CornerRadius="9" Background="White" BorderBrush="#C9D8EB" BorderThickness="1">
                            <TextBlock x:Name="Tick" Text="✓" Foreground="White" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Dot" Property="Background" Value="#00B981"/>
                                <Setter TargetName="Dot" Property="BorderBrush" Value="#00B981"/>
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Dot" Property="BorderBrush" Value="#287DFF"/>
                                <Setter TargetName="Dot" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IssueCellText" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="MaxHeight" Value="60"/>
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
        </Style>


        <!-- ── 值转换器 ──────────────────────────────────────── -->
        <conv:BoolVisConverter x:Key="BoolVis"/>
        <conv:RequiredColorConverter x:Key="RequiredColor"/>
        <conv:IssueColorConverter x:Key="IssueColor"/>

        <!-- ── 步骤圆圈 ─────────────────────────────────────── -->
        <Style x:Key="StepCircle" TargetType="Border">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="CornerRadius" Value="15"/>
            <Setter Property="Background" Value="#D1D5DB"/>
        </Style>
        <Style x:Key="StepCircleActive" TargetType="Border" BasedOn="{StaticResource StepCircle}">
            <Setter Property="Background" Value="#4E6EF2"/>
        </Style>
        <Style x:Key="StepCircleDone" TargetType="Border" BasedOn="{StaticResource StepCircle}">
            <Setter Property="Background" Value="#10B981"/>
        </Style>
    </Page.Resources>

    <DockPanel Margin="24,16,24,20">

        <!-- ══ 页头 ══════════════════════════════════════════════ -->
        <Grid x:Name="WizardTitlePanel" DockPanel.Dock="Top" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="数据验证排查" FontSize="22" FontWeight="Bold" Foreground="#111827"/>
                <TextBlock Text="粘贴建表语句和插入语句，自动完成字段映射与入库前校验，生成错误报告。"
                           Margin="0,4,0,0" FontSize="13" Foreground="#64748B"/>
            </StackPanel>
            <ToggleButton x:Name="BtnDebugMode"
                          Grid.Column="1"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Top"
                          Content="调试模式：关"
                          Style="{StaticResource DebugToggleButton}"
                          Padding="14,7"
                          FontSize="12"
                          ToolTip="开启后可跳过结构、数据和映射输入，使用内置演示数据继续向导"
                          Checked="DebugMode_Changed"
                          Unchecked="DebugMode_Changed"/>
        </Grid>

        <!-- ══ 步骤指示器 ════════════════════════════════════════ -->
        <Border x:Name="WizardStepPanel" DockPanel.Dock="Top" Style="{DynamicResource CardBorder}" Padding="20,14" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

                <!-- Step 1 -->
                <StackPanel HorizontalAlignment="Center" Width="80">
                    <Border x:Name="Step1Circle" Style="{StaticResource StepCircleActive}"
                            HorizontalAlignment="Center">
                        <TextBlock x:Name="Step1Num" Text="1" FontSize="13" FontWeight="Bold"
                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="Step1Label" Text="结构输入" FontSize="11" TextAlignment="Center"
                               Foreground="#4E6EF2" FontWeight="SemiBold" Margin="0,4,0,0"/>
                </StackPanel>

                <Border Width="60" Height="2" Background="#D1D5DB" VerticalAlignment="Center"
                        Margin="0,0,0,18" x:Name="Line12"/>

                <!-- Step 2 -->
                <StackPanel HorizontalAlignment="Center" Width="80">
                    <Border x:Name="Step2Circle" Style="{StaticResource StepCircle}"
                            HorizontalAlignment="Center">
                        <TextBlock x:Name="Step2Num" Text="2" FontSize="13" FontWeight="Bold"
                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="Step2Label" Text="数据输入" FontSize="11" TextAlignment="Center"
                               Foreground="#9CA3AF" Margin="0,4,0,0"/>
                </StackPanel>

                <Border Width="60" Height="2" Background="#D1D5DB" VerticalAlignment="Center"
                        Margin="0,0,0,18" x:Name="Line23"/>

                <!-- Step 3 -->
                <StackPanel HorizontalAlignment="Center" Width="80">
                    <Border x:Name="Step3Circle" Style="{StaticResource StepCircle}"
                            HorizontalAlignment="Center">
                        <TextBlock x:Name="Step3Num" Text="3" FontSize="13" FontWeight="Bold"
                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="Step3Label" Text="字段映射" FontSize="11" TextAlignment="Center"
                               Foreground="#9CA3AF" Margin="0,4,0,0"/>
                </StackPanel>

                <Border Width="60" Height="2" Background="#D1D5DB" VerticalAlignment="Center"
                        Margin="0,0,0,18" x:Name="Line34"/>

                <!-- Step 4 -->
                <StackPanel HorizontalAlignment="Center" Width="80">
                    <Border x:Name="Step4Circle" Style="{StaticResource StepCircle}"
                            HorizontalAlignment="Center">
                        <TextBlock x:Name="Step4Num" Text="4" FontSize="13" FontWeight="Bold"
                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="Step4Label" Text="校验结果" FontSize="11" TextAlignment="Center"
                               Foreground="#9CA3AF" Margin="0,4,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ══ 第 4 步专用结果页头 ════════════════════════════════ -->
        <Border x:Name="ResultHeaderPanel"
                DockPanel.Dock="Top"
                Visibility="Collapsed"
                Background="White"
                BorderBrush="#E1E8F2"
                BorderThickness="1"
                CornerRadius="10"
                Padding="18,14"
                Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="42"
                            Height="42"
                            CornerRadius="21"
                            Background="#EEF4FF"
                            BorderBrush="#CBDAFF"
                            BorderThickness="1"
                            Margin="0,0,12,0">
                        <TextBlock Text="🔎"
                                   Foreground="#4E6EF2"
                                   FontSize="18"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="数据验证排查"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="#111827"/>
                        <TextBlock Text="粘贴表结构或输入语句，自动完成字段映射与入库前校验，生成错误报告。"
                                   Margin="0,4,0,0"
                                   FontSize="12.5"
                                   Foreground="#7B8798"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="26,0,24,0">
                    <StackPanel HorizontalAlignment="Center" Width="80">
                        <Border Width="28" Height="28" CornerRadius="14" Background="#10B981" HorizontalAlignment="Center">
                            <TextBlock Text="✓" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="结构输入" Margin="0,5,0,0" FontSize="11" Foreground="#334155" TextAlignment="Center"/>
                    </StackPanel>
                    <Border Width="72" Height="1" Background="#10B981" Margin="0,0,0,18" VerticalAlignment="Center"/>
                    <StackPanel HorizontalAlignment="Center" Width="80">
                        <Border Width="28" Height="28" CornerRadius="14" Background="#10B981" HorizontalAlignment="Center">
                            <TextBlock Text="✓" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="数据输入" Margin="0,5,0,0" FontSize="11" Foreground="#334155" TextAlignment="Center"/>
                    </StackPanel>
                    <Border Width="72" Height="1" Background="#10B981" Margin="0,0,0,18" VerticalAlignment="Center"/>
                    <StackPanel HorizontalAlignment="Center" Width="80">
                        <Border Width="28" Height="28" CornerRadius="14" Background="#10B981" HorizontalAlignment="Center">
                            <TextBlock Text="✓" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="字段映射" Margin="0,5,0,0" FontSize="11" Foreground="#334155" TextAlignment="Center"/>
                    </StackPanel>
                    <Border Width="72" Height="1" Background="#10B981" Margin="0,0,0,18" VerticalAlignment="Center"/>
                    <StackPanel HorizontalAlignment="Center" Width="80">
                        <Border Width="28" Height="28" CornerRadius="14" Background="#4E6EF2" HorizontalAlignment="Center">
                            <TextBlock Text="4" FontSize="13" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="校验结果" Margin="0,5,0,0" FontSize="11" Foreground="#4E6EF2" FontWeight="SemiBold" TextAlignment="Center"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnRunValidation"
                            Content="⚡️ 开始校验"
                            Style="{DynamicResource ButtonPrimary}"
                            Padding="18,10"
                            MinWidth="128"
                            Margin="0,0,10,0"
                            Click="BtnRunValidation_Click"/>
                    <Button x:Name="BtnExportReport"
                            Content="导出 Excel 报告"
                            Style="{DynamicResource ButtonSuccess}"
                            Padding="18,10"
                            MinWidth="150"
                            Visibility="Collapsed"
                            Click="BtnExportReport_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══ 导航按钮行（固定底部）══════════════════════════════ -->
        <Border DockPanel.Dock="Bottom" Padding="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TxtStatus" Grid.Column="0" FontSize="12"
                           Foreground="#64748B" VerticalAlignment="Center"/>
                <Button x:Name="BtnBack" Grid.Column="1" Content="← 上一步"
                        Style="{DynamicResource ButtonGhost}" Margin="0,0,8,0"
                        Visibility="Collapsed" Click="BtnBack_Click"/>
                <Button x:Name="BtnNext" Grid.Column="2" Content="下一步 →"
                        Style="{DynamicResource ButtonPrimary}" Click="BtnNext_Click"/>
            </Grid>
        </Border>

        <!-- ══ 步骤内容区（填满剩余空间）══════════════════════════ -->
        <Border>
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource CardBorder}">
                    <Setter Property="Padding" Value="24,20"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Visibility, ElementName=Panel1}" Value="Visible">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="0"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Visibility, ElementName=Panel2}" Value="Visible">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="0"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Visibility, ElementName=Panel3}" Value="Visible">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="0"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid x:Name="ContentArea">

                <!-- ─── Step 1：结构输入 ─────────────────────── -->
                <DockPanel x:Name="Panel1" Visibility="Visible">
                    <Border DockPanel.Dock="Top" Style="{StaticResource StructureCard}" Margin="0,0,0,14">
                    <Grid Margin="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="32"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="280"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="数据库类型" FontSize="13" FontWeight="SemiBold"
                                   Foreground="#374151" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <ComboBox x:Name="CbDatabaseType" Grid.Column="1" SelectedIndex="0"
                                  Style="{DynamicResource ComboBoxStandard}"
                                  ItemContainerStyle="{DynamicResource ComboBoxItemStandard}"
                                  SelectionChanged="DbType_Changed">
                            <ComboBoxItem Content="PostgreSQL"/>
                            <ComboBoxItem Content="SQL Server"/>
                        </ComboBox>
                        <TextBlock Grid.Column="3" Text="目标表名" FontSize="13" FontWeight="SemiBold"
                                   Foreground="#374151" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <TextBox x:Name="TxtTableName" Grid.Column="4" Style="{StaticResource RoundedInputBox}"/>
                    </Grid>
                    </Border>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2.4*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*" MinWidth="320"/>
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource StructureCard}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="结构输入方式" FontSize="17" FontWeight="SemiBold"
                                           Foreground="#263D5C" Margin="0,0,0,12"/>
                                <Border x:Name="DdlCard" Padding="14,16" CornerRadius="7" Background="#FAFCFF"
                                        BorderBrush="#BCCDFF" BorderThickness="1">
                                    <DockPanel>
                                        <RadioButton x:Name="RbDdlMode" DockPanel.Dock="Top" Content="DDL 建表语句（推荐）"
                                                     GroupName="StructMode" IsChecked="True" Style="{StaticResource StructureModeRadio}"
                                                     Checked="StructMode_Changed"/>
                                        <TextBlock DockPanel.Dock="Top" Text="直接粘贴 CREATE TABLE 语句，表名和字段会自动解析"
                                                   FontSize="12" Foreground="#8392AA" Margin="28,8,0,18" TextWrapping="Wrap"/>
                                        <Grid DockPanel.Dock="Bottom" Margin="0,18,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="TxtDdlStatus" FontSize="12" Foreground="#64748B"
                                                       VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"/>
                                            <Button Grid.Column="1" Content="清空" Style="{StaticResource StructureOutlineButton}"
                                                    MinWidth="68" Margin="0,0,14,0" Click="BtnClearDdl_Click"/>
                                            <Button Grid.Column="2" Content="⚡️  解析 DDL" Style="{DynamicResource ButtonPrimary}"
                                                    Background="#1665FF" Padding="16,9" FontSize="12" Click="BtnParseDdl_Click"/>
                                        </Grid>
                                        <Border BorderBrush="#E1E9F5" BorderThickness="1" CornerRadius="6" Background="White">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="38"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Background="#F5F8FD" BorderBrush="#E1E9F5" BorderThickness="0,0,1,0" CornerRadius="6,0,0,6">
                                                    <Grid>
                                                        <Canvas x:Name="DdlLineNumbers" ClipToBounds="True" IsHitTestVisible="False"/>
                                                        <TextBlock Text="1" Margin="0,12,8,0" HorizontalAlignment="Right" VerticalAlignment="Top"
                                                                   FontFamily="Consolas" FontSize="12" Foreground="#94A3B8">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Text, ElementName=TxtDdl}" Value="">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Grid>
                                                </Border>
                                                <TextBox x:Name="TxtDdl" Grid.Column="1" AcceptsReturn="True" AcceptsTab="True"
                                                         Style="{StaticResource StructureEditor}" TextWrapping="NoWrap"
                                                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                                         Loaded="DdlEditorViewport_Changed" SizeChanged="DdlEditorViewport_Changed"
                                                         ScrollViewer.ScrollChanged="DdlEditorViewport_Changed"/>
                                                <TextBlock Grid.Column="1" Text="请在此处粘贴 CREATE TABLE 语句..." Margin="10,12,10,0"
                                                           Foreground="#94A3B8" FontSize="12" IsHitTestVisible="False" VerticalAlignment="Top">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Text, ElementName=TxtDdl}" Value="">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <Border x:Name="DdlPasteOverlay" Grid.ColumnSpan="2" Visibility="Collapsed"
                                                        Background="#E8EEFFCC" CornerRadius="6">
                                                    <TextBlock Text="正在粘贴数据..." FontSize="14" FontWeight="SemiBold"
                                                               Foreground="#4E6EF2" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DockPanel>
                                </Border>
                            </DockPanel>
                        </Border>
                        <Border x:Name="StructExcelCard" Grid.Column="2" Style="{StaticResource StructureCard}">
                            <DockPanel Margin="0,4,0,8">
                                <RadioButton x:Name="RbExcelStructMode" DockPanel.Dock="Top" Content="SQL 查询导入（备用）"
                                             GroupName="StructMode" Style="{StaticResource StructureModeRadio}" Checked="StructMode_Changed"/>
                                <TextBlock DockPanel.Dock="Top" Text="在数据库中执行以下查询，将结果导出为 Excel 后导入"
                                           FontSize="12" Foreground="#8392AA" Margin="16,10,0,18" TextWrapping="Wrap"/>
                                <Border BorderBrush="#E5EDF8" BorderThickness="1" CornerRadius="6">
                                    <DockPanel>
                                        <Border DockPanel.Dock="Bottom" Padding="14,18" BorderBrush="#E5EDF8" BorderThickness="0,1,0,0">
                                            <StackPanel>
                                                <WrapPanel>
                                                    <Button Content="复制查询语句" Style="{StaticResource StructureOutlineButton}"
                                                            Margin="0,0,12,6" Click="BtnCopyStructQuery_Click"/>
                                                    <Button Content="导入结果 Excel" Style="{DynamicResource ButtonPrimary}"
                                                            Background="#647795" Padding="12,9" FontSize="12" Margin="0,0,0,6"
                                                            Click="BtnImportStructExcel_Click"/>
                                                </WrapPanel>
                                                <TextBlock x:Name="TxtStructExcelInfo" FontSize="12" Foreground="#64748B" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                        <TextBox x:Name="TxtStructQuery" IsReadOnly="True" AcceptsReturn="True"
                                                 Style="{StaticResource StructureEditor}" TextWrapping="NoWrap" Background="#F6F9FE"
                                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Padding="14,14"/>
                                    </DockPanel>
                                </Border>
                            </DockPanel>
                        </Border>
                    </Grid>
                </DockPanel>

                <!-- ─── Step 2：数据输入 ─────────────────────── -->
                <Grid x:Name="Panel2" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*" MinWidth="330"/>
                    </Grid.ColumnDefinitions>
                    <Border x:Name="InsertCard" Style="{StaticResource StructureCard}" Padding="22,24">
                        <DockPanel>
                            <RadioButton x:Name="RbInsertMode" DockPanel.Dock="Top" Content="INSERT INTO 语句（推荐）"
                                         GroupName="DataMode" IsChecked="True" Style="{StaticResource StructureModeRadio}"
                                         Checked="DataMode_Changed"/>
                            <TextBlock DockPanel.Dock="Top" Text="直接粘贴 INSERT INTO 语句，支持单行/多行/多值"
                                       FontSize="13" Foreground="#8392AA" Margin="28,10,0,16" TextWrapping="Wrap"/>
                            <Grid DockPanel.Dock="Bottom" Margin="0,22,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="TxtInsertStatus" FontSize="12" Foreground="#64748B"
                                           VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"/>
                                <Button Grid.Column="1" Content="清空" Style="{StaticResource StructureOutlineButton}"
                                        MinWidth="64" Margin="0,0,12,0" Click="BtnClearInsert_Click"/>
                                <Button Grid.Column="2" Content="▶  解析 INSERT" Style="{DynamicResource ButtonPrimary}"
                                        Background="#4865FF" Padding="16,9" FontSize="13" Click="BtnParseInsert_Click"/>
                            </Grid>
                            <Border Background="#F7F9FC" BorderBrush="#DCE5F2" BorderThickness="1" CornerRadius="8">
                                <Grid>
                                    <TextBox x:Name="TxtInsert" AcceptsReturn="True" AcceptsTab="True"
                                             Style="{StaticResource StructureEditor}" Background="#F7F9FC" Padding="18,18"
                                             TextWrapping="NoWrap" FontSize="13"
                                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                                    <TextBlock Text="请在此处粘贴 INSERT INTO 语句..." Margin="18,18,18,0"
                                               Foreground="#94A3B8" FontSize="13" IsHitTestVisible="False" VerticalAlignment="Top">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=TxtInsert}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <Border x:Name="InsertPasteOverlay" Visibility="Collapsed" Background="#E8EEFFCC" CornerRadius="8">
                                        <TextBlock Text="正在粘贴数据..." FontSize="14" FontWeight="SemiBold"
                                                   Foreground="#4E6EF2" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </DockPanel>
                    </Border>
                    <Border x:Name="DataExcelCard" Grid.Column="2" Style="{StaticResource StructureCard}" Padding="22,24">
                        <DockPanel>
                            <RadioButton x:Name="RbExcelDataMode" DockPanel.Dock="Top" Content="Excel 数据文件（备用）"
                                         GroupName="DataMode" Style="{StaticResource StructureModeRadio}" Checked="DataMode_Changed"/>
                            <TextBlock DockPanel.Dock="Top" Text="导入中间表数据 Excel，第一行必须为表头"
                                       FontSize="13" Foreground="#8392AA" Margin="28,10,0,22" TextWrapping="Wrap"/>
                            <Border DockPanel.Dock="Bottom" Background="#F2F6FD" CornerRadius="8" Padding="18,16" Margin="0,18,0,0">
                                <StackPanel>
                                    <TextBlock Text="●  注意事项" FontSize="13" FontWeight="SemiBold" Foreground="#4D69C9" Margin="0,0,0,8"/>
                                    <TextBlock Text="•  Excel 文件需包含表头，第一行作为字段名" Style="{StaticResource DataImportNote}"/>
                                    <TextBlock Text="•  仅读取第一个工作表，请将数据合并到同一工作表" Style="{StaticResource DataImportNote}"/>
                                    <TextBlock Text="•  请确保数据格式与目标表结构匹配" Style="{StaticResource DataImportNote}"/>
                                </StackPanel>
                            </Border>
                            <Grid>
                                <Rectangle Fill="#F7F9FD" Stroke="#D6E3FA" StrokeThickness="1.5" StrokeDashArray="4,3" RadiusX="8" RadiusY="8"/>
                                <StackPanel VerticalAlignment="Center" Margin="18,24">
                                    <Viewbox Width="46" Height="52" Margin="0,0,0,24">
                                        <Canvas Width="46" Height="52">
                                            <Path Data="M 8,2 L 30,2 L 42,14 L 42,46 Q 42,50 38,50 L 8,50 Q 4,50 4,46 L 4,6 Q 4,2 8,2 M 30,2 L 30,14 L 42,14"
                                                  Stroke="#536CFF" StrokeThickness="3" StrokeLineJoin="Round"/>
                                            <Path Data="M 13,24 L 33,24 M 13,31 L 33,31 M 13,38 L 33,38 M 13,24 L 13,38 M 23,24 L 23,38 M 33,24 L 33,38"
                                                  Stroke="#536CFF" StrokeThickness="3"/>
                                        </Canvas>
                                    </Viewbox>
                                    <Button Content="导入数据 Excel" Style="{DynamicResource ButtonPrimary}"
                                            Background="#4865FF" Padding="20,10" FontSize="14" HorizontalAlignment="Center"
                                            Click="BtnImportDataExcel_Click"/>
                                    <TextBlock Text="支持 .xlsx / .xls 格式" Foreground="#8392AA" FontSize="12"
                                               TextAlignment="Center" Margin="0,16,0,0"/>
                                    <TextBlock x:Name="TxtDataExcelInfo" FontSize="12" Foreground="#64748B"
                                               TextAlignment="Center" Margin="0,12,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                        </DockPanel>
                    </Border>
                </Grid>

                <!-- ─── Step 3：字段映射 ─────────────────────── -->
                <DockPanel x:Name="Panel3" Visibility="Collapsed" LastChildFill="True">
                    <Border DockPanel.Dock="Top" Style="{StaticResource MappingCard}" Margin="0,0,0,16">
                        <DockPanel LastChildFill="True">
                            <!-- 主键选择 -->
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,14">
                                <TextBlock Text="中间表主键" FontSize="13" FontWeight="SemiBold"
                                    Foreground="#374151" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <ComboBox x:Name="CbPk1" Width="170" Margin="0,0,8,0"
                                    Style="{StaticResource MappingPkCombo}"
                                    ItemContainerStyle="{DynamicResource ComboBoxItemStandard}"
                                    MaxDropDownHeight="240"
                                    SelectionChanged="PrimaryKey_Changed"/>
                                <ComboBox x:Name="CbPk2" Width="170" Margin="0,0,12,0"
                                    Style="{StaticResource MappingPkCombo}"
                                    ItemContainerStyle="{DynamicResource ComboBoxItemStandard}"
                                    MaxDropDownHeight="240"
                                    SelectionChanged="PrimaryKey_Changed"/>
                                <TextBlock Text="(选填，用于错误报告中按主键定位记录)" FontSize="11"
                                    Foreground="#879BB7" VerticalAlignment="Center"/>
                            </StackPanel>
                            <!-- 工具栏 -->
                            <Grid DockPanel.Dock="Top" Margin="0,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="#233F69" TextWrapping="Wrap">
                                        <Run Text="字段映射配置"/>
                                        <Run x:Name="RunMappingInfo" Text="" Foreground="#7990B1" FontWeight="Normal" FontSize="12"/>
                                    </TextBlock>
                                    <TextBlock x:Name="TxtMappingHint" FontSize="12" Foreground="#EF4444"
                                        Margin="0,2,0,0" Visibility="Collapsed" TextWrapping="Wrap"
                                        Text="存在待处理映射，请先处理高亮行后再继续"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Content="⛨  忽略自动生成UUID" Style="{StaticResource MappingToolbarButton}"
                                        Padding="12,7" FontSize="12" Margin="0,0,10,0"
                                        Click="BtnIgnoreAllUuid_Click"/>
                                    <Button Content="⟳  重新自动映射" Style="{StaticResource MappingToolbarButton}"
                                        Padding="12,7" FontSize="12" Margin="0,0,10,0"
                                        Click="BtnAutoMap_Click"/>
                                    <Button x:Name="BtnNextUnconfirmed" Content="↓ 未确认" Style="{StaticResource MappingToolbarButton}"
                                        Padding="12,7" FontSize="12" Margin="0,0,10,0"
                                        Click="BtnNextUnconfirmed_Click"/>
                                    <Button Content="✓  全部确认" Style="{DynamicResource ButtonSuccess}" Background="#00B981"
                                        Padding="12,7" FontSize="12"
                                        Click="BtnConfirmAll_Click"/>
                                </StackPanel>
                            </Grid>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource MappingCard}">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="340"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Background="#287DFF" CornerRadius="7" Width="32" Height="32" Margin="0,0,12,0">
                                        <TextBlock Text="▤" Foreground="White" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="字段映射列表" FontSize="16" FontWeight="SemiBold" Foreground="#233F69" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Border Grid.Column="1" BorderBrush="#E3ECF9" BorderThickness="1" CornerRadius="14" Background="#FBFDFF" Padding="12,5">
                                    <DockPanel>
                                        <TextBlock Text="⌕" FontSize="20" Foreground="#7792B7" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TxtMappingCount" DockPanel.Dock="Right" Text="0 条记录" Foreground="#347FFF" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                        <Grid>
                                            <TextBox x:Name="TxtMappingSearch" BorderThickness="0" Background="Transparent" Padding="0,2" FontSize="12" VerticalContentAlignment="Center" TextChanged="MappingSearch_Changed"/>
                                            <TextBlock Text="搜索字段名、目标字段名或类型..." IsHitTestVisible="False" Foreground="#8B9EB8" FontSize="11" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Text, ElementName=TxtMappingSearch}" Value="">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </DockPanel>
                                </Border>
                            </Grid>
                            <Border DockPanel.Dock="Bottom" Background="#F2F7FE" CornerRadius="10" Padding="16,14" Margin="0,14,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="●" Foreground="#287DFF" Margin="0,0,10,0"/>
                                    <TextBlock x:Name="TxtMappingSummary" Foreground="#7990B1" FontSize="12" Text="总计 0 条记录，已确认 0 条，未确认 0 条"/>
                                </StackPanel>
                            </Border>
                            <!-- 字段映射 DataGrid -->
                            <Border BorderBrush="#E5EDF8" BorderThickness="1" CornerRadius="0" Padding="0">
                                <DataGrid x:Name="DgMapping" IsReadOnly="True"
                                    AutoGenerateColumns="False"
                                    CanUserAddRows="False"
                                    CanUserDeleteRows="False"
                                    CanUserReorderColumns="False"
                                    CanUserSortColumns="False"
                                    CanUserResizeColumns="True"
                                    CanUserResizeRows="False"
                                    GridLinesVisibility="None"
                                    HeadersVisibility="Column"
                                    HorizontalGridLinesBrush="#EEF2F7"
                                    BorderThickness="0"
                                    Background="White"
                                    AlternationCount="2"
                                    ColumnHeaderStyle="{StaticResource DataGridHeaderStyle}"
                                    CellStyle="{StaticResource DataGridCellStyle}"
                                    RowStyle="{StaticResource DgMappingRow}"
                                    SelectionMode="Single"
                                    SelectionUnit="FullRow"
                                    VerticalScrollBarVisibility="Auto"
                                    FontSize="12"
                                    PreviewKeyDown="DataGrid_PreviewKeyDown"
                                    PreviewMouseRightButtonDown="DataGrid_PreviewMouseRightButtonDown">
                                    <DataGrid.ContextMenu>
                                        <ContextMenu Style="{StaticResource GridContextMenu}">
                                            <MenuItem Header="复制当前单元格"
                                                Style="{StaticResource GridContextMenuItem}"
                                                Click="CopyCurrentCellMenu_Click"/>
                                            <MenuItem Header="复制当前行"
                                                Style="{StaticResource GridContextMenuItem}"
                                                Click="CopyCurrentRowMenu_Click"/>
                                        </ContextMenu>
                                    </DataGrid.ContextMenu>
                                    <DataGrid.Columns>
                                        <!-- 序号 -->
                                        <DataGridTextColumn Header="序号" Binding="{Binding RowIndex}"
                                            Width="0.45*" MinWidth="52" IsReadOnly="True"/>
                                        <!-- 目标字段 -->
                                        <DataGridTextColumn Header="目标字段" Binding="{Binding TargetColumnName}" ElementStyle="{StaticResource MappingFieldText}"
                                            Width="1.05*" MinWidth="110" IsReadOnly="True"/>
                                        <!-- 类型 -->
                                        <DataGridTextColumn Header="目标类型" Binding="{Binding TargetDisplayType}"
                                            Width="1*" MinWidth="105" IsReadOnly="True"/>
                                        <!-- 必填 -->
                                        <DataGridTemplateColumn Header="必填" Width="0.6*" MinWidth="52" IsReadOnly="True">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="5" Padding="6,3">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="#EDF2F8"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsRequired}" Value="True">
                                                                        <Setter Property="Background" Value="#FFE3E5"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Foreground="{Binding IsRequired, Converter={StaticResource RequiredColor}}" FontWeight="SemiBold">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Text" Value="否"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsRequired}" Value="True">
                                                                            <Setter Property="Text" Value="是"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Border>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <!-- 映射方式 -->
                                        <DataGridTemplateColumn Header="映射方式" Width="1.05*" MinWidth="110">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <ComboBox x:Name="MappingTypeEditor" Style="{StaticResource MappingInlineCombo}"
                                                        SelectedItem="{Binding MappingTypeStr, UpdateSourceTrigger=PropertyChanged}"
                                                        ItemsSource="{Binding DataContext.MappingTypeOptions, RelativeSource={RelativeSource AncestorType=Page}}"
                                                        SelectionChanged="MappingType_Changed"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <!-- 来源/值（动态） -->
                                        <DataGridTemplateColumn Header="来源字段 / 固定值" Width="1.45*" MinWidth="150">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <Grid>
                                                            <!-- Source: ComboBox -->
                                                            <ComboBox Style="{StaticResource MappingInlineCombo}" Foreground="#29476F"
                                                                Visibility="{Binding IsSourceMode, Converter={StaticResource BoolVis}}"
                                                                SelectedItem="{Binding SourceColumnName, UpdateSourceTrigger=PropertyChanged}"
                                                                ItemsSource="{Binding DataContext.SourceHeaders, RelativeSource={RelativeSource AncestorType=Page}}"
                                                                SelectionChanged="SourceColumn_Changed"/>
                                                            <!-- Constant: TextBox -->
                                                            <TextBox Visibility="{Binding IsConstantMode, Converter={StaticResource BoolVis}}"
                                                                Text="{Binding ConstantValue, UpdateSourceTrigger=PropertyChanged}"
                                                                TextChanged="ConstantValue_Changed"
                                                                TextAlignment="Center" VerticalContentAlignment="Center"
                                                                BorderThickness="0" Background="Transparent" FontSize="12" Padding="4,2"/>
                                                        </Grid>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <!-- 匹配方式 -->
                                        <DataGridTextColumn Header="匹配方式" Binding="{Binding MatchMethodText}"
                                            Width="1*" MinWidth="90" IsReadOnly="True"/>
                                        <!-- 命中原因 -->
                                        <DataGridTextColumn Header="命中原因" Binding="{Binding MatchReasonText}"
                                            Width="1.2*" MinWidth="125" IsReadOnly="True"/>
                                        <!-- 置信度 -->
                                        <DataGridTemplateColumn Header="置信度" Width="1.1*" MinWidth="95" IsReadOnly="True">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel VerticalAlignment="Center" Margin="6,0">
                                                        <TextBlock Text="{Binding ConfidenceText}" FontSize="13" Margin="0,0,0,6"/>
                                                        <ProgressBar Value="{Binding Confidence}" Maximum="100" Height="5" Foreground="#00B981" Background="#E8F4EF" BorderThickness="0">
                                                            <ProgressBar.Template>
                                                                <ControlTemplate TargetType="ProgressBar">
                                                                    <Grid x:Name="PART_Track">
                                                                        <Border Background="{TemplateBinding Background}" CornerRadius="3"/>
                                                                        <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" CornerRadius="3"/>
                                                                    </Grid>
                                                                </ControlTemplate>
                                                            </ProgressBar.Template>
                                                        </ProgressBar>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <!-- 已确认 -->
                                        <DataGridTemplateColumn Header="已确认" Width="0.7*" MinWidth="64">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <CheckBox Style="{StaticResource MappingConfirmed}" Checked="MappingConfirmation_Changed" Unchecked="MappingConfirmation_Changed" IsChecked="{Binding IsConfirmed, UpdateSourceTrigger=PropertyChanged}"
                                                        HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="操作" Width="0.9*" MinWidth="86">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="✎  编辑" Style="{StaticResource MappingEditButton}" HorizontalAlignment="Center" Click="EditMapping_Click" ToolTip="编辑本行的映射方式"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>
                        </DockPanel>
                    </Border>
                </DockPanel>

                <!-- ─── Step 4：校验结果 ─────────────────────── -->
                <DockPanel x:Name="Panel4" Visibility="Collapsed" LastChildFill="True">

                    <Border x:Name="ExportStatusPanel"
                            DockPanel.Dock="Bottom"
                            Visibility="Collapsed"
                            Background="#F8FBFF"
                            BorderBrush="#D8E6FF"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12,9"
                            Margin="0,12,0,0">
                        <TextBlock FontSize="12.5" Foreground="#334155" VerticalAlignment="Center">
                            <Run Text="报告已导出："/>
                            <Hyperlink Click="ExportedReportLink_Click">
                                <Run x:Name="RunExportedReportName" Text=""/>
                            </Hyperlink>
                        </TextBlock>
                    </Border>

                    <Border x:Name="SummaryCard"
                            DockPanel.Dock="Top"
                            Visibility="Collapsed"
                            Background="Transparent"
                            BorderThickness="0"
                            Margin="0,0,0,12">
                        <UniformGrid Columns="5">
                            <Border Style="{StaticResource MetricCard}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="46"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="40" Height="40" CornerRadius="20" Background="#EAF1FF">
                                        <TextBlock Text="📋" Foreground="#4076EE" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                        <TextBlock Text="总记录数" FontSize="11.5" Foreground="#64748B"/>
                                        <TextBlock x:Name="TxtTotalRows" Text="0" Margin="0,6,0,0" FontSize="22" FontWeight="Bold" Foreground="#172033"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource MetricCard}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="46"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="40" Height="40" CornerRadius="20" Background="#FFF4D7">
                                        <TextBlock Text="❗" Foreground="#F59E0B" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                        <TextBlock Text="异常记录数" FontSize="11.5" Foreground="#64748B"/>
                                        <TextBlock x:Name="TxtErrorCount" Text="0" Margin="0,6,0,0" FontSize="22" FontWeight="Bold" Foreground="#F59E0B"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource MetricCard}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="46"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="40" Height="40" CornerRadius="20" Background="#FFE9E9">
                                        <TextBlock Text="❌" Foreground="#EF4444" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                        <TextBlock Text="错误项数" FontSize="11.5" Foreground="#64748B"/>
                                        <TextBlock x:Name="TxtRawErrorCount" Text="0" Margin="0,6,0,0" FontSize="22" FontWeight="Bold" Foreground="#EF4444"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource MetricCard}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="46"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="40" Height="40" CornerRadius="20" Background="#F0E9FF">
                                        <TextBlock Text="🚫" Foreground="#7C3AED" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                        <TextBlock Text="警告记录数" FontSize="11.5" Foreground="#64748B"/>
                                        <TextBlock x:Name="TxtWarningCount" Text="0" Margin="0,6,0,0" FontSize="22" FontWeight="Bold" Foreground="#7C3AED"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource DashboardPanel}" Padding="16,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="46"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="40" Height="40" CornerRadius="20" Background="#E7F8F0">
                                        <TextBlock Text="🕛" Foreground="#059669" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                        <TextBlock Text="耗时" FontSize="11.5" Foreground="#64748B"/>
                                        <TextBlock x:Name="TxtElapsed" Text="0.0s" Margin="0,6,0,0" FontSize="22" FontWeight="Bold" Foreground="#172033"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </UniformGrid>
                    </Border>

                    <Border x:Name="ProgressPanel"
                            DockPanel.Dock="Top"
                            Visibility="Collapsed"
                            Background="#EEF2FF"
                            BorderBrush="#DDE5FF"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="16,12"
                            Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock x:Name="TxtProgress"
                                           Text="校验中..."
                                           FontSize="13"
                                           Foreground="#1E3A8A"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,8"/>
                                <ProgressBar x:Name="PbProgress"
                                             Height="8"
                                             Value="0"
                                             Maximum="100"
                                             Background="#CBD5E1"
                                             Foreground="#4E6EF2"/>
                            </StackPanel>
                            <Button x:Name="BtnCancelValidation"
                                    Grid.Column="1"
                                    Content="取消"
                                    Style="{DynamicResource ButtonGhost}"
                                    Padding="14,6"
                                    FontSize="12"
                                    Margin="14,0,0,0"
                                    VerticalAlignment="Center"
                                    Click="BtnCancelValidation_Click"/>
                        </Grid>
                    </Border>

                    <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.18*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Style="{StaticResource DashboardPanel}"
                                Padding="16,14"
                                Margin="0,0,12,0">
                            <StackPanel>
                                <DockPanel LastChildFill="True">
                                    <TextBlock Text="校验规则"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               Foreground="#172033"/>
                                    <TextBlock Text="仅影响格式校验，适合在明确了解数据来源时临时放宽。"
                                               Margin="12,2,0,0"
                                               FontSize="11.5"
                                               Foreground="#8291A7"/>
                                </DockPanel>

                                <Border BorderBrush="#E7EDF5"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Margin="0,12,0,0"
                                        ClipToBounds="True">
                                    <StackPanel>
                                        <CheckBox x:Name="ChkSkipIntFormat"
                                                  Style="{StaticResource DashboardRuleSwitch}"
                                                  Tag="✏️"
                                                  IsChecked="True"
                                                  ToolTip="存储过程会做类型转换时可勾选，跳过整数/长整数格式校验">
                                            <StackPanel>
                                                <TextBlock Text="忽略整数格式错误" FontWeight="SemiBold" Foreground="#172033"/>
                                                <TextBlock Text="忽略整数值字段的格式错误" Margin="0,2,0,0" FontSize="11" Foreground="#8291A7"/>
                                            </StackPanel>
                                        </CheckBox>
                                        <CheckBox x:Name="ChkSkipUuidFormat"
                                                  Style="{StaticResource DashboardRuleSwitch}"
                                                  Tag="✏️"
                                                  IsChecked="False"
                                                  ToolTip="勾选后将跳过 UUID / UNIQUEIDENTIFIER 字段的格式错误校验">
                                            <StackPanel>
                                                <TextBlock Text="忽略 UUID 格式错误" FontWeight="SemiBold" Foreground="#172033"/>
                                                <TextBlock Text="忽略非 UUID 字符串的格式错误" Margin="0,2,0,0" FontSize="11" Foreground="#8291A7"/>
                                            </StackPanel>
                                        </CheckBox>
                                        <CheckBox x:Name="ChkSkipDateTimeFormat"
                                                  Style="{StaticResource DashboardRuleSwitch}"
                                                  Tag="✏️"
                                                  IsChecked="False"
                                                  ToolTip="勾选后将跳过 datetime / timestamp 等字段的日期时间格式错误校验">
                                            <StackPanel>
                                                <TextBlock Text="忽略日期时间格式错误" FontWeight="SemiBold" Foreground="#172033"/>
                                                <TextBlock Text="忽略非日期时间导致的格式错误" Margin="0,2,0,0" FontSize="11" Foreground="#8291A7"/>
                                            </StackPanel>
                                        </CheckBox>
                                        <CheckBox x:Name="ChkSkipActualValues"
                                                  Style="{StaticResource DashboardRuleSwitch}"
                                                  Tag="✏️"
                                                  IsChecked="True"
                                                  BorderThickness="0"
                                                  ToolTip="勾选后，命中下方列表的实际值将跳过类型和格式校验">
                                            <StackPanel>
                                                <TextBlock Text="忽略指定实际值" FontWeight="SemiBold" Foreground="#172033"/>
                                                <TextBlock Text="对指定值不进行格式校验" Margin="0,2,0,0" FontSize="11" Foreground="#8291A7"/>
                                            </StackPanel>
                                        </CheckBox>
                                    </StackPanel>
                                </Border>

                                <DockPanel Margin="0,14,0,8" LastChildFill="True">
                                    <TextBlock Text="忽略值设置"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="#172033"/>
                                    <TextBlock Text="输入多个值用逗号、分号、换行或空格分隔，空白值仍按必填校验。"
                                               Margin="12,1,0,0"
                                               FontSize="11"
                                               Foreground="#8291A7"/>
                                </DockPanel>

                                <Border BorderBrush="#E1E8F2" BorderThickness="1" CornerRadius="8" Padding="10,8">
                                    <DockPanel LastChildFill="True">
                                        <Button x:Name="BtnClearIgnoredActualValues"
                                                DockPanel.Dock="Right"
                                                Content="清空"
                                                Style="{DynamicResource ButtonGhost}"
                                                Padding="12,6"
                                                FontSize="12"
                                                Margin="8,0,0,0"
                                                Click="BtnClearIgnoredActualValues_Click"/>
                                        <Button x:Name="BtnAddSelectedActualValue"
                                                DockPanel.Dock="Right"
                                                Content="加入选中实际值"
                                                Style="{DynamicResource ButtonGhost}"
                                                Padding="12,6"
                                                FontSize="12"
                                                Margin="8,0,0,0"
                                                Click="BtnAddSelectedActualValue_Click"/>
                                        <WrapPanel VerticalAlignment="Center">
                                            <ItemsControl x:Name="IgnoredValuesItems">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="#F3F6FC"
                                                                BorderBrush="#DCE5F3"
                                                                BorderThickness="1"
                                                                CornerRadius="7"
                                                                Padding="8,4"
                                                                Margin="0,0,6,6">
                                                            <DockPanel LastChildFill="False">
                                                                <TextBlock Text="{Binding}"
                                                                           FontSize="12"
                                                                           Foreground="#334155"
                                                                           VerticalAlignment="Center"/>
                                                                <Button Content="×"
                                                                        Tag="{Binding}"
                                                                        Width="18"
                                                                        Height="18"
                                                                        Margin="4,0,0,0"
                                                                        Padding="0"
                                                                        FontSize="12"
                                                                        Foreground="#94A3B8"
                                                                        Background="Transparent"
                                                                        BorderThickness="0"
                                                                        Cursor="Hand"
                                                                        Click="IgnoredValueTagRemove_Click"/>
                                                            </DockPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </WrapPanel>
                                        <TextBox x:Name="TxtIgnoredActualValues"
                                                 Text="-"
                                                 Visibility="Collapsed"/>
                                    </DockPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1"
                                Style="{StaticResource DashboardPanel}"
                                Padding="16,14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0"
                                           Text="错误统计（按错误类型）"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="#172033"/>
                                <Grid Grid.Row="1" Margin="0,16,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid Width="210" Height="210" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Canvas x:Name="IssueChartCanvas"
                                                Width="190"
                                                Height="190"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"/>
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock x:Name="TxtIssueChartTotal"
                                                       Text="0"
                                                       FontSize="20"
                                                       FontWeight="SemiBold"
                                                       Foreground="#172033"
                                                       HorizontalAlignment="Center"/>
                                            <TextBlock Text="总错误"
                                                       Margin="0,4,0,0"
                                                       FontSize="11.5"
                                                       Foreground="#64748B"
                                                       HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>
                                    <ItemsControl x:Name="IssueTypeStatsItems"
                                                  Grid.Column="1"
                                                  VerticalAlignment="Center">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="#E7EDF5"
                                                        BorderThickness="0,0,0,1"
                                                        Padding="0,11">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="64"/>
                                                            <ColumnDefinition Width="82"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Ellipse Width="8" Height="8" Fill="{Binding Brush}" Margin="0,0,8,0"/>
                                                            <TextBlock Text="{Binding ErrorType}" FontSize="12.5" Foreground="#334155"/>
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding Count}"
                                                                   FontSize="12.5"
                                                                   Foreground="#EF4444"
                                                                   HorizontalAlignment="Right"
                                                                   VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="2"
                                                                   Text="{Binding PercentageText}"
                                                                   FontSize="12.5"
                                                                   Foreground="#8291A7"
                                                                   HorizontalAlignment="Right"
                                                                   VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                                <Border Grid.Row="2"
                                        Background="#F1F7FF"
                                        BorderBrush="#B7D3FF"
                                        BorderThickness="1"
                                        CornerRadius="7"
                                        Padding="10,8">
                                    <TextBlock Text="提示：当前只统计错误项，不包含已被忽略的项。"
                                               FontSize="11.5"
                                               Foreground="#4076EE"/>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- 错误列表 DataGrid -->
                    <Border Style="{StaticResource MappingCard}">
                        <DockPanel LastChildFill="True">
                            <Grid DockPanel.Dock="Top" Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Background="#287DFF" CornerRadius="7" Width="32" Height="32" Margin="0,0,12,0">
                                        <TextBlock Text="▤" Foreground="White" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="错误明细" VerticalAlignment="Center"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               Foreground="#233F69"/>
                                    <TextBlock x:Name="TxtIssueVisibleCount"
                                               Text="共 0 条"
                                               Margin="14,0,0,0" VerticalAlignment="Center"
                                               FontSize="12"
                                               Foreground="#7990B1"/>
                                </StackPanel>
                                <ComboBox x:Name="CbIssueTypeFilter"
                                          Grid.Column="1"
                                          Style="{StaticResource FilterCombo}" Background="#FBFDFF" BorderBrush="#E3ECF9"
                                          SelectionChanged="CbIssueTypeFilter_SelectionChanged"
                                          Margin="0,0,10,0"/>
                                <Border Grid.Column="2" Width="260" BorderBrush="#E3ECF9" BorderThickness="1"
                                        CornerRadius="14" Background="#FBFDFF" Padding="12,5" Margin="0,0,10,0">
                                    <DockPanel>
                                        <TextBlock Text="⌕" FontSize="20" Foreground="#7792B7" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <Grid>
                                            <TextBox x:Name="TxtIssueSearch" BorderThickness="0" Background="Transparent"
                                                     Padding="0,2" FontSize="12" VerticalContentAlignment="Center"
                                                     ToolTip="输入关键词搜索" TextChanged="TxtIssueSearch_TextChanged"/>
                                            <TextBlock Text="搜索字段、实际值或说明..." IsHitTestVisible="False"
                                                       Foreground="#8B9EB8" FontSize="11" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Text, ElementName=TxtIssueSearch}" Value="">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </DockPanel>
                                </Border>
                                <Button x:Name="BtnRefreshIssueView"
                                        Grid.Column="3"
                                        Content="⟳ 刷新"
                                        Style="{StaticResource MappingToolbarButton}"
                                        Padding="14,8"
                                        FontSize="12"
                                        Click="BtnRefreshIssueView_Click"/>
                            </Grid>
                            <Border BorderBrush="#E5EDF8" BorderThickness="1" CornerRadius="0">
                            <DataGrid x:Name="DgIssues"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      CanUserReorderColumns="False"
                                      CanUserSortColumns="True"
                                      CanUserResizeColumns="True"
                                      CanUserResizeRows="False"
                                      IsReadOnly="True"
                                      GridLinesVisibility="None" HeadersVisibility="Column"
                                      HorizontalGridLinesBrush="#EEF2F7"
                                      BorderBrush="#E7EDF5"
                                      BorderThickness="0"
                                      Background="White"
                                      AlternationCount="2"
                                      ColumnHeaderStyle="{StaticResource DataGridHeaderStyle}"
                                      CellStyle="{StaticResource DataGridCellStyle}"
                                      RowStyle="{StaticResource DataGridRowStyle}"
                                      SelectionMode="Single"
                                      SelectionUnit="FullRow"
                                      VerticalScrollBarVisibility="Auto"
                                      FontSize="12"
                                      PreviewKeyDown="DataGrid_PreviewKeyDown"
                                      PreviewMouseRightButtonDown="DataGrid_PreviewMouseRightButtonDown">
                                <DataGrid.ContextMenu>
                                    <ContextMenu Style="{StaticResource GridContextMenu}">
                                        <MenuItem Header="复制当前单元格"
                                                  Style="{StaticResource GridContextMenuItem}"
                                                  Click="CopyCurrentCellMenu_Click"/>
                                        <MenuItem Header="复制当前行"
                                                  Style="{StaticResource GridContextMenuItem}"
                                                  Click="CopyCurrentRowMenu_Click"/>
                                    </ContextMenu>
                                </DataGrid.ContextMenu>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="序号" Binding="{Binding RowNumber}" Width="0.45*" MinWidth="52"/>
                                    <DataGridTextColumn Header="主键" Binding="{Binding PrimaryKeyDisplay}" Width="1.5*" MinWidth="180" ElementStyle="{StaticResource IssueCellText}"/>
                                    <DataGridTextColumn Header="源字段" Binding="{Binding SourceColumnName}" Width="1*" MinWidth="120" ElementStyle="{StaticResource IssueCellText}"/>
                                    <DataGridTextColumn Header="目标字段" Binding="{Binding TargetColumnName}" Width="1*" MinWidth="130" ElementStyle="{StaticResource IssueCellText}"/>
                                    <DataGridTextColumn Header="目标类型" Binding="{Binding TargetDataType}" Width="0.9*" MinWidth="120" ElementStyle="{StaticResource IssueCellText}"/>
                                    <DataGridTemplateColumn Header="错误类型" Width="1.2*" MinWidth="150" SortMemberPath="ErrorType">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource IssueTypePill}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding ErrorType}"
                                                               FontSize="11.5"
                                                               FontWeight="SemiBold"
                                                               Foreground="#EF4444"/>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="实际值" Binding="{Binding ActualValue}" Width="1.1*" MinWidth="140" ElementStyle="{StaticResource IssueCellText}"/>
                                    <DataGridTextColumn Header="说明" Binding="{Binding Message}" Width="1.8*" MinWidth="180" ElementStyle="{StaticResource IssueCellText}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            </Border>
                        </DockPanel>
                    </Border>
                </DockPanel>

            </Grid>
        </Border>
    </DockPanel>
</Page>

