<Window x:Class="WpfApp1.Views.QuickNotesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="随手记" Width="480" Height="560" MinWidth="400" MinHeight="420"
        WindowStartupLocation="CenterOwner" Icon="pack://application:,,,/favicon.ico"
        WindowStyle="None" ResizeMode="CanResizeWithGrip" ShowInTaskbar="False"
        AllowsTransparency="True" Background="Transparent"
        Closing="Window_Closing" PreviewKeyDown="Window_PreviewKeyDown">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0"
                             CornerRadius="16" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="CloseButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CloseChrome" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CloseChrome" Property="Background" Value="#FEE2E2"/>
                                <Setter Property="Foreground" Value="#DC2626"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CloseChrome" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="16">
            <Border.Effect>
                <DropShadowEffect BlurRadius="22" ShadowDepth="0" Opacity="0.2" Color="#1E293B"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border x:Name="TitleBar" Grid.Row="0" Padding="20,16,14,14"
                        Background="#F7F9FC" CornerRadius="16,16,0,0"
                        PreviewMouseLeftButtonDown="TitleBar_PreviewMouseLeftButtonDown">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Image Width="32" Height="32" Source="pack://application:,,,/favicon.ico"/>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="随手记" FontSize="18" FontWeight="SemiBold" Foreground="#0F172A"/>
                            <TextBlock Text="本地 TXT 文件" Margin="0,2,0,0" FontSize="11" Foreground="#64748B"/>
                        </StackPanel>
                        <Button Grid.Column="2" Content="×" Style="{StaticResource CloseButtonStyle}"
                                Click="CloseButton_Click" ToolTip="关闭"/>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Margin="20,16,20,12" Padding="12,10"
                        Background="#EDF3FF" BorderBrush="#DCE7FF" BorderThickness="1" CornerRadius="10">
                    <DockPanel>
                        <TextBlock Text="●" DockPanel.Dock="Left" FontSize="11" Foreground="#4E6EF2" Margin="0,0,8,0"/>
                        <TextBlock Text="内容会在关闭窗口时自动保存" FontSize="12" Foreground="#425466" VerticalAlignment="Center"/>
                    </DockPanel>
                </Border>

                <Border x:Name="FindBar" Grid.Row="2" Margin="20,0,20,12" Padding="12"
                        Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10"
                        Visibility="Collapsed">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <Button Content="×" DockPanel.Dock="Right" Style="{StaticResource CloseButtonStyle}"
                                    Width="28" Height="28" FontSize="17" Click="CloseFindBar_Click" ToolTip="关闭查找"/>
                            <TextBlock Text="查找与替换" FontSize="12" FontWeight="SemiBold"
                                       Foreground="#334155" VerticalAlignment="Center"/>
                        </DockPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="查找" Margin="0,0,8,0" VerticalAlignment="Center"
                                       FontSize="12" Foreground="#64748B"/>
                            <TextBox x:Name="FindInput" Grid.Column="1" Height="32" Padding="8,5"
                                     Style="{DynamicResource TextBoxStandard}"/>
                            <Button Grid.Column="2" Content="上一个" Margin="8,0,0,0" Height="32"
                                    Style="{StaticResource ButtonSmall}" Background="#E5E7EB"
                                    Foreground="#475569" Padding="10,0" Click="FindPrevious_Click"/>
                            <Button Grid.Column="3" Content="下一个" Margin="6,0,0,0" Height="32"
                                    Style="{StaticResource ButtonSmall}" Background="{DynamicResource PrimaryBrush}"
                                    Foreground="White" Padding="10,0" Click="FindNext_Click"/>
                        </Grid>
                        <Grid x:Name="ReplaceRow" Margin="0,8,0,0" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="替换" Margin="0,0,8,0" VerticalAlignment="Center"
                                       FontSize="12" Foreground="#64748B"/>
                            <TextBox x:Name="ReplaceInput" Grid.Column="1" Height="32" Padding="8,5"
                                     Style="{DynamicResource TextBoxStandard}"/>
                            <Button Grid.Column="2" Content="替换当前" Margin="8,0,0,0" Height="32"
                                    Style="{StaticResource ButtonSmall}" Background="#E5E7EB"
                                    Foreground="#475569" Padding="10,0" Click="ReplaceCurrent_Click"/>
                            <Button Grid.Column="3" Content="全部替换" Margin="6,0,0,0" Height="32"
                                    Style="{StaticResource ButtonSmall}" Background="{DynamicResource PrimaryBrush}"
                                    Foreground="White" Padding="10,0" Click="ReplaceAll_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBox x:Name="NoteEditor" Grid.Row="3" Margin="20,0,20,0"
                         Style="{DynamicResource TextBoxStandard}" AcceptsReturn="True" TextWrapping="Wrap"
                         VerticalContentAlignment="Top" Padding="14" FontSize="14"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"/>

                <Grid Grid.Row="4" Margin="20,12,20,18">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock x:Name="SaveStatus" VerticalAlignment="Center" FontSize="11"
                               Foreground="#64748B" Text=""/>
                    <Button Grid.Column="1" Content="保存" Width="78" Height="36"
                            Style="{StaticResource ButtonPrimary}" Click="SaveButton_Click"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
